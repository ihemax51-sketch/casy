<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\KMTGuard.AdminDesktop\Assets\Brand\kmt.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\KMTGuard.AdminDesktop\Assets\Brand\kmt-logo.png" Link="Assets\Brand\kmt-logo.png" />
    <Resource Include="..\KMTGuard.AdminDesktop\Assets\Brand\kmt.ico" Link="Assets\Brand\kmt.ico" />
    <Page Include="..\KMTGuard.AdminDesktop\Themes\KmtLightTheme.xaml" Link="Themes\KmtLightTheme.xaml" />
    <Compile Include="..\KMTGuard.LicenseAdmin\Services\PackageBindingResource.cs" Link="Services\PackageBindingResource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KMTGuard.Licensing\KMTGuard.Licensing.csproj" />
  </ItemGroup>
</Project>
