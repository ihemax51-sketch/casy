void CIFSecondaryPassword::RefreshFocusVisuals()
{
    for (int i = 0; i < 3; ++i)
    {
        const bool selected = m_lastFocusedField == i + 1;
        if (m_fieldLabels[i] && m_fieldLabels[i]->IsVisible())
        {
            m_fieldLabels[i]->m_FontTexture.SetColor(
                selected ? COLOR_SELECTED : COLOR_LABEL);
        }
    }
}

std::n_wstring* CIFSecondaryPassword::PasswordForEdit(CIFEdit* edit)
{
    if (edit == myFirstPasswordBox)
        return &Pass1;
    if (edit == mySecondPasswordBox)
        return &Pass2;
    if (edit == myThirdPasswordBox)
        return &Pass3;
    return 0;
}

bool CIFSecondaryPassword::HandlePasswordCharacter(
    CIFEdit* edit,
    wchar_t character)
{
    std::n_wstring* password = PasswordForEdit(edit);
    if (!password || !edit)
        return false;

    if (character == VK_BACK)
    {
        if (!password->empty())
            password->erase(password->length() - 1, 1);
    }
    else if (character >= L'0' && character <= L'9')
    {
        const size_t maximumLength = Mode == 3 ? 4 : 8;
        if (password->length() < maximumLength)
            *password += character;
    }
    else
    {
        return false;
    }

    // Keep the real digits only in Pass1/Pass2/Pass3 and render a same-length
    // mask in the static display field.
    std::n_wstring masked(password->length(), L'*');
    int fieldId = edit == myFirstPasswordBox
        ? 1
        : (edit == mySecondPasswordBox ? 2 : 3);
    if (m_fieldDisplays[fieldId - 1])
        m_fieldDisplays[fieldId - 1]->SetText(masked.c_str());
    RefreshActionState();
    return true;
}

bool CIFSecondaryPassword::HandleWindowKey(UINT message, WPARAM key)
{
    if (!IsVisible())
        return false;

    if (m_lastFocusedField < 1 || m_lastFocusedField > 3)
        FocusField(1);

    const int fieldId = m_lastFocusedField;
    CIFEdit* edit = fieldId == 1
        ? myFirstPasswordBox
        : (fieldId == 2 ? mySecondPasswordBox : myThirdPasswordBox);
    if (!edit || !m_fieldDisplays[fieldId - 1] ||
        !m_fieldDisplays[fieldId - 1]->IsVisible())
        return true;

    if (message == WM_KEYDOWN)
    {
        if (key == VK_RETURN)
        {
            SubmitFromKeyboard();
            return true;
        }

        if (key == VK_TAB)
        {
            FocusNextField((GetKeyState(VK_SHIFT) & 0x8000) != 0);
            return true;
        }

        if (key == VK_DELETE)
        {
            HandlePasswordCharacter(edit, VK_BACK);
            return true;
        }

        return true;
    }

    if (message == WM_CHAR)
    {
        if (key == VK_RETURN || key == VK_TAB)
            return true;

        if (key == VK_BACK)
        {
            HandlePasswordCharacter(edit, VK_BACK);
            return true;
        }

        if (key >= L'0' && key <= L'9')
        {
            HandlePasswordCharacter(edit, (wchar_t)key);
            return true;
        }

        return true;
    }

    return false;
}

void CIFSecondaryPassword::RefreshActionState()
{
    // Classic com_button does not provide a visually consistent disabled
    // surface. Keep actions available and validate when they are pressed.
    if (m_submitButton)
        m_submitButton->SetEnabledState(true);
    if (m_confirmButton)
        m_confirmButton->SetEnabledState(true);
}

void CIFSecondaryPassword::SubmitFromKeyboard()
{
    if (Mode == 0 && m_lastFocusedField == 1)
    {
        FocusField(2);
        return;
    }
    if (Mode == 2 && m_lastFocusedField < 3)
    {
        FocusField(m_lastFocusedField + 1);
        return;
    }

    if (Mode == 0 || Mode == 2)
        CreatePassword();
    else
        Confirm();
}

void CIFSecondaryPassword::Confirm()
{
    if (Mode == 1)
    {
        if (!IsValidPasscodeLength(Pass1))
        {
            ShowParentMessage(
                KmtGetText(L"UIIT_KMT_THE_PASSCODE_MUST_BE_BETWEEN_6_8_DIGITS"));
            return;
        }

        ReleaseFieldFocus();
        CMsgStreamBuffer buf(0x1211);
        buf << (byte)2;
        buf << ParsePasscode(Pass1);
        buf << (byte)m_rememberCheckBox->GetCheckedState_MAYBE();
        SendMsg(buf);
    }
    else if (Mode == 3)
    {
        if (Pass1.length() != 4)
            return;

        ReleaseFieldFocus();
        CMsgStreamBuffer buf(0x169A);
        buf << (byte)30;
        buf << ParsePasscode(Pass1);
        SendMsg(buf);

        ClearAll();
        ShowGWnd(false);
    }
}

void CIFSecondaryPassword::RemovePw()
{
    ReleaseFieldFocus();
    SetMode(2);
}

void CIFSecondaryPassword::ShowParentMessage(const wchar_t* text)
{
    if (GetParentControl()->IsSame(GFX_RUNTIME_CLASS(CPSTitle)))
    {
        CPSTitle* titleWindow = (CPSTitle*)GetParentControl();
        titleWindow->ShowMessage(text, COLOR_WARNING);
    }
}

void CIFSecondaryPassword::CreatePassword()
{
    if (Mode == 0)
    {
        if (!IsValidPasscodeLength(Pass1) ||
            !IsValidPasscodeLength(Pass2))
        {
            ShowParentMessage(
                KmtGetText(L"UIIT_KMT_THE_PASSCODE_MUST_BE_BETWEEN_6_8_DIGITS"));
            return;
        }

        if (Pass1 != Pass2)
        {
            ShowParentMessage(KmtGetText(L"UIIT_KMT_PASSWORDS_DOESNT_MATCH"));
            FocusField(2);
            return;
        }

        ReleaseFieldFocus();
        CMsgStreamBuffer buf(0x1211);
        buf << (byte)0;
        buf << ParsePasscode(Pass1);
        SendMsg(buf);
    }
    else if (Mode == 2)
    {
        if (!IsValidPasscodeLength(Pass1) ||
            !IsValidPasscodeLength(Pass2) ||
            !IsValidPasscodeLength(Pass3))
        {
            ShowParentMessage(
                KmtGetText(L"UIIT_KMT_THE_PASSCODE_MUST_BE_BETWEEN_6_8_DIGITS"));
            return;
        }

        if (Pass2 != Pass3)
        {
            ShowParentMessage(KmtGetText(L"UIIT_KMT_PASSWORDS_DOESNT_MATCH"));
            FocusField(3);
            return;
        }

        ReleaseFieldFocus();
        CMsgStreamBuffer buf(0x1211);
        buf << (byte)1;
        buf << ParsePasscode(Pass1);
        buf << ParsePasscode(Pass3);
        SendMsg(buf);
    }
}

void CIFSecondaryPassword::ClearAll()
{
    Pass1.clear();
    Pass2.clear();
    Pass3.clear();

    CIFStatic* fields[3] = {
        m_fieldDisplays[0],
        m_fieldDisplays[1],
        m_fieldDisplays[2]
    };
    for (int i = 0; i < 3; ++i)
    {
        if (fields[i])
            fields[i]->SetText(L"");
    }
    RefreshActionState();
}

void CIFSecondaryPassword::UpdateMenuSize()
{
    int screenWidth = 1024;
    int screenHeight = 768;
    if (g_CGame && g_CGame->GetRes().res)
    {
        screenWidth = g_CGame->GetRes().res->width;
        screenHeight = g_CGame->GetRes().res->height;
    }

    int x = (screenWidth - WINDOW_WIDTH) / 2;
    int y = ((screenHeight - WINDOW_HEIGHT) / 2) + 10;
    if (x < 0)
        x = 0;
    if (y < 0)
        y = 0;
    if (y + WINDOW_HEIGHT > screenHeight)
        y = screenHeight - WINDOW_HEIGHT;
    if (y < 0)
        y = 0;

    MoveGWnd(x, y);
    BringToFront();
}

void CIFSecondaryPassword::OnUpdate()
{
    // Keyboard routing is owned by the game window.  Nothing in Secondary
    // needs to touch native window handles during the render/update loop.
}

void CIFSecondaryPassword::Clear()
{
    ClearAll();
}

void CIFSecondaryPassword::ShowTradeSellCaptcha(int code, int timeoutSeconds)
{
    UpdateMenuSize();
    ShowGWnd(true);
    SetMode(3);

    wchar_t codeText[96];
    wchar_t timeoutText[192];
    swprintf(codeText, 96, KmtGetText(L"UIIT_KMT_CODE_VALUE"), code);
    swprintf(
        timeoutText,
        192,
        KmtGetText(L"UIIT_KMT_ENTER_THE_CODE_WITHIN_VALUE_SECONDS"),
        timeoutSeconds);

    std::wstringstream text;
    text << KmtGetText(L"UIIT_KMT_TRADE_GOODS_VERIFICATION_REQUIRED")
         << L"\n" << codeText
         << L"  -  " << timeoutText;
    DescTextBox->SetText(text.str().c_str());

    FocusField(1);
    BringToFront();
}

undefined1 CIFSecondaryPassword::OnCloseWnd()
{
    OnClickCancelBtn();
    return true;
}

void CIFSecondaryPassword::OnClickCancelBtn()
{
    ReleaseFieldFocus();
    if (Mode == 0 || Mode == 1)
    {
        CIFNewMsgBox* messageBox =
            m_IRM.GetResObj<CIFNewMsgBox>(ID_MESSAGE_BOX, 1);
        if (messageBox)
        {
            messageBox->UpdateMenuSize();
            messageBox->ShowGWnd(true);
        }
    }
    else if (Mode == 2)
    {
        SetMode(1);
    }
    else if (Mode == 3)
    {
        ClearAll();
        ShowGWnd(false);
    }
}

void CIFSecondaryPassword::SetRememberPC(bool remember)
{
    if (m_rememberCheckBox)
        m_rememberCheckBox->SetCheckBoxState(remember);
}
