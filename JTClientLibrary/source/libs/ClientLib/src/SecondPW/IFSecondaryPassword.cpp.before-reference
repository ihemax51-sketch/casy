void CIFSecondaryPassword::ConfigureField(
    int fieldId,
    bool visible,
    const wchar_t* label)
{
    if (fieldId < 1 || fieldId > 3)
        return;

    const int index = fieldId - 1;
    CIFEdit* edits[3] = {
        myFirstPasswordBox,
        mySecondPasswordBox,
        myThirdPasswordBox
    };
    CIFStatic* displays[3] = {
        m_fieldDisplays[0],
        m_fieldDisplays[1],
        m_fieldDisplays[2]
    };

    if (m_fieldLabels[index])
    {
        m_fieldLabels[index]->SetText(label ? label : L"");
        m_fieldLabels[index]->SetFont(theApp.GetFont(0));
        m_fieldLabels[index]->m_FontTexture.SetColor(COLOR_LABEL);
        m_fieldLabels[index]->JustifyHorizontal(CTextBoard::JUSTIFY_LEFT);
        m_fieldLabels[index]->JustifyVertical(CTextBoard::JUSTIFY_MIDDLE);
        m_fieldLabels[index]->ShowGWnd(visible);
        if (visible)
            m_fieldLabels[index]->BringToFront();
    }

    if (m_fieldBackgrounds[index])
    {
        m_fieldBackgrounds[index]->ShowGWnd(visible);
        if (visible)
            m_fieldBackgrounds[index]->BringToFront();
    }

    if (m_fieldTiles[index])
    {
        m_fieldTiles[index]->ShowGWnd(visible);
        if (visible)
            m_fieldTiles[index]->BringToFront();
    }

    if (edits[index])
    {
        edits[index]->SetClickable(false);
        edits[index]->ShowGWnd(false);
    }

    if (displays[index])
    {
        displays[index]->SetClickable(false);
        displays[index]->ShowGWnd(visible);
        if (visible)
            displays[index]->BringToFront();
    }
}

