void CIFSecondaryPassword::FocusField(int fieldId)
{
    CIFStatic* field = 0;
    if (fieldId == 1)
        field = m_fieldDisplays[0];
    else if (fieldId == 2)
        field = m_fieldDisplays[1];
    else if (fieldId == 3)
        field = m_fieldDisplays[2];

    if (!field || !field->IsVisible())
        return;

    m_Player->FocusedId = fieldId;
    m_lastFocusedField = fieldId;
    SetFocus_MAYBE();
    RefreshFocusVisuals();
}

void CIFSecondaryPassword::ReleaseFieldFocus()
{
    m_Player->FocusedId = 0;
}

void CIFSecondaryPassword::ShowGWnd(bool visible)
{
    if (!visible)
        ReleaseFieldFocus();

    CIFMainFrame::ShowGWnd(visible);

    if (visible)
    {
        g_activeSecondaryPassword = this;
        FocusField(m_lastFocusedField >= 1 && m_lastFocusedField <= 3
            ? m_lastFocusedField
            : 1);
    }
    else if (g_activeSecondaryPassword == this)
        g_activeSecondaryPassword = 0;
}

void CIFSecondaryPassword::FocusNextField(bool backwards)
{
    int fields[3] = {1, 0, 0};
    int count = 1;
    if (Mode == 0)
    {
        fields[1] = 2;
        count = 2;
    }
    else if (Mode == 2)
    {
        fields[1] = 2;
        fields[2] = 3;
        count = 3;
    }

    int currentIndex = 0;
    for (int i = 0; i < count; ++i)
    {
        if (fields[i] == m_lastFocusedField)
        {
            currentIndex = i;
            break;
        }
    }

    if (backwards)
        currentIndex = (currentIndex + count - 1) % count;
    else
        currentIndex = (currentIndex + 1) % count;

    const int nextField = fields[currentIndex];
    if (!backwards && nextField == fields[0] &&
        m_lastFocusedField == fields[count - 1] && count > 1)
    {
        SubmitFromKeyboard();
        return;
    }

    FocusField(nextField);
}

int CIFSecondaryPassword::OnMouseLeftUp(int a1, int x, int y)
{
    CIFStatic* fields[3] = {
        m_fieldDisplays[0],
        m_fieldDisplays[1],
        m_fieldDisplays[2]
    };

    for (int i = 0; i < 3; ++i)
    {
        if (fields[i] && fields[i]->IsVisible() &&
            IsPointInsideControlWithParentOffset(this, fields[i], x, y))
        {
            FocusField(i + 1);
            return 1;
        }
    }

    return CIFMainFrame::OnMouseLeftUp(a1, x, y);
}

