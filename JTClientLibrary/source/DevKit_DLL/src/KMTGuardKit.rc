#include <winver.h>
#include "KmtGuardClientVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION KMTGUARD_CLIENT_VERSION_RESOURCE
 PRODUCTVERSION KMTGUARD_CLIENT_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KMTGuard"
            VALUE "FileDescription", "KMTGuard Client DLL"
            VALUE "FileVersion", KMTGUARD_CLIENT_FILE_VERSION_STRING
            VALUE "InternalName", "KMTGuardKit.dll"
            VALUE "OriginalFilename", "KMTGuardKit.dll"
            VALUE "ProductName", "KMTGuard"
            VALUE "ProductVersion", KMTGUARD_CLIENT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
