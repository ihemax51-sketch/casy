<Window x:Class="KMTGuard.LicenseAdmin.ChangeServerIpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Server IPs" Width="470" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        Icon="Assets/Brand/kmt.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="Change Licensed Server IPs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="One independent server slot is allowed for each listed IP." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18">
            <TextBlock Text="CUSTOMER" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="CustomerText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock Text="SERVER IPV4 ADDRESSES (ONE PER LINE)" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
            <TextBox x:Name="ServerIpBox" MaxLength="1024" Height="90" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <Border Background="{StaticResource BlueSoftBrush}" BorderBrush="#C8DAEA" BorderThickness="1"
                    CornerRadius="5" Padding="11" Margin="0,15,0,0">
                <TextBlock Text="Deliver the newly generated package, then restart the Filter services on the licensed server."
                           Foreground="{StaticResource BlueBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="90" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save IPs" Width="105" Margin="8,0,0,0" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
