<Window x:Class="KMTGuard.LicenseAdmin.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KMTGuard Update Publisher"
        Width="900" Height="680" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Icon="Assets/Brand/kmt.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update Publisher" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Publish one licensed release for every active customer" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource GoldSoftBrush}" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="CURRENT PRODUCT &#x00B7; VERSION 2" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="NEW RELEASE" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="VERSION" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="VersionBox" Text="2.5.7" />
                        <TextBlock Text="RELEASE TITLE" Style="{StaticResource FieldLabel}" Margin="0,15,0,5" />
                        <TextBox x:Name="TitleBox" Text="KMTGuard 2" />
                        <TextBlock Text="CUSTOMER CHANGELOG" Style="{StaticResource FieldLabel}" Margin="0,15,0,5" />
                        <TextBox x:Name="NotesBox" Height="145" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="KMTGuard 2 introduces secure automatic Filter updates and guided DLL delivery." />
                        <TextBlock Text="UPDATE COMPONENTS" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <TextBlock Text="Select only the components that changed."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="FilterBox" Content="Filter" IsChecked="True" Margin="0,0,8,8" />
                            <CheckBox x:Name="ClientDllBox" Content="Client DLL" Margin="0,0,0,8" />
                            <CheckBox x:Name="GameServerDllBox" Content="GameServer DLL" Margin="0,0,8,8" />
                            <CheckBox x:Name="ShardManagerDllBox" Content="ShardManager DLL" Margin="0,0,0,8" />
                            <CheckBox x:Name="IncludeDatabaseBox" Content="Database / New SQL" Margin="0,0,8,0" />
                            <CheckBox x:Name="IncludeMediaBox" Content="Media / New Media" />
                        </UniformGrid>
                        <CheckBox x:Name="MandatoryBox" Content="Mark this update as required" Margin="0,10,0,0" />
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PUBLISHED RELEASES" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="ReleasesList" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PublishedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding PackageSize, StringFormat={}{0:N0} bytes}" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="StatusText"
                           Text="Publishing uses CustomerProductionBase and never includes customer settings or license files."
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Close" Width="90" IsCancel="True" />
                    <Button x:Name="PublishButton" Style="{StaticResource PrimaryButton}" Content="Publish update" Width="138" Margin="9,0,0,0" Click="PublishButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
