<Window x:Class="KMTGuard.LicenseAdmin.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Customer" Width="520" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}" Icon="Assets/Brand/kmt.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
        <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,0" VerticalAlignment="Center"><TextBlock Text="Create Customer" Style="{StaticResource PageTitle}" /><TextBlock Text="The package will be generated immediately after creation." Style="{StaticResource MutedText}" Margin="0,3,0,0" /></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18">
                <TextBlock Text="CUSTOMER NAME" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CustomerNameBox" MaxLength="120" />
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="SUBSCRIPTION" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="MonthsCombo" SelectedIndex="0"><ComboBoxItem Content="1 month" Tag="1" /><ComboBoxItem Content="3 months" Tag="3" /><ComboBoxItem Content="6 months" Tag="6" /><ComboBoxItem Content="12 months" Tag="12" /></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="OFFLINE GRACE" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="OfflineCombo" SelectedIndex="1"><ComboBoxItem Content="12 hours" Tag="12" /><ComboBoxItem Content="24 hours" Tag="24" /><ComboBoxItem Content="48 hours" Tag="48" /><ComboBoxItem Content="72 hours" Tag="72" /></ComboBox></StackPanel>
                </Grid>
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LICENSE BINDING" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BindingModeCombo" SelectedIndex="0" SelectionChanged="BindingModeCombo_SelectionChanged">
                            <ComboBoxItem Content="Public IP only" Tag="IP" />
                            <ComboBoxItem Content="Player limit only (no IP)" Tag="LIMIT" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NUMBER OF GAME SERVERS" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="InstancesCombo" SelectedIndex="0" SelectionChanged="InstancesCombo_SelectionChanged">
                            <ComboBoxItem Content="1 GameServer" Tag="1" />
                            <ComboBoxItem Content="2 GameServers" Tag="2" />
                            <ComboBoxItem Content="3 GameServers" Tag="3" />
                            <ComboBoxItem Content="4 GameServers" Tag="4" />
                            <ComboBoxItem Content="5 GameServers" Tag="5" />
                            <ComboBoxItem Content="8 GameServers" Tag="8" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="BindingModeHelp"
                           Text="IP mode checks the licensed public IP only."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                <StackPanel x:Name="ServerIpSection" Margin="0,15,0,0">
                    <TextBlock x:Name="ServerIpLabel" Text="GAME SERVER PUBLIC IPV4 SLOTS" Style="{StaticResource FieldLabel}" />
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="12" Margin="0,5,0,0">
                        <StackPanel x:Name="ServerIpFieldsPanel" />
                    </Border>
                </StackPanel>
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="MAXIMUM ONLINE PLAYERS" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MaximumPlayersBox" Text="1000" MaxLength="5" /></StackPanel>
                </Grid>
                <TextBlock Text="Signed into the customer license. Valid range: 1 to 10,000 players."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                <TextBlock Text="LICENSED COMPONENTS" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="13">
                    <UniformGrid Columns="1" Rows="4">
                        <CheckBox x:Name="FilterCheck" Content="Filter (Desktop, Agent, Gateway and Download)" IsChecked="True" Margin="0,3" />
                        <CheckBox x:Name="GameServerCheck" Content="GameServer Addon" IsChecked="True" Margin="0,7,0,3" />
                        <CheckBox x:Name="ShardManagerCheck" Content="ShardManager Addon" IsChecked="True" Margin="0,7,0,3" />
                        <CheckBox x:Name="ClientDllCheck" Content="KMTGuard client DLL" IsChecked="True" Margin="0,7,0,3" />
                    </UniformGrid>
                </Border>
                <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}" Margin="0,18,0,5" />
                <TextBox x:Name="NotesBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="90" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="Create &amp; Generate" Width="150" Margin="8,0,0,0" Click="CreateButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
