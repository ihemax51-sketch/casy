APP_NAME=CASY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://admin.play-casy.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# Optional first-run defaults for the CASY server profile. Keep the password
# only in the local .env file; it is encrypted when saved to the application DB.
CASY_DEFAULT_SQL_NAME="My SRO server"
CASY_DEFAULT_SQL_HOST=54.37.205.126
CASY_DEFAULT_SQL_PORT=1433
CASY_DEFAULT_SQL_USERNAME=sa
CASY_DEFAULT_SQL_PASSWORD=
CASY_DEFAULT_ACCOUNT_DATABASE=SRO_VT_ACCOUNT
CASY_DEFAULT_SHARD_DATABASE=SRO_VT_SHARD
CASY_DEFAULT_LOG_DATABASE=SRO_VT_SHARDLOG
CASY_DEFAULT_PROXY_DATABASE=KMTGUARD
CASY_DEFAULT_ICON_ROOT=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
