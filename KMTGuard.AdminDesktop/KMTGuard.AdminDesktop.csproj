<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(KmtDevelopmentBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);KMT_DEVELOPMENT_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\Brand\kmt.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\kmt-logo.png" />
    <Resource Include="Assets\Brand\kmt.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\filter\KMTGuardnew\KMTGuard.RuntimeContract\KMTGuard.RuntimeContract.csproj" />
    <ProjectReference Include="..\KMTGuard.Licensing\KMTGuard.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KMTGuard.AdminDesktop.RuntimeTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
