<Window x:Class="KMTGuard.AdminDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KMTGuard Sign In"
        Width="720"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/Brand/kmt.ico"
        Opacity="0"
        ContentRendered="LoginWindow_ContentRendered"
        Closing="LoginWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource WindowFrameBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="0.985" ScaleY="0.985" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                        <Image Source="Assets/Brand/kmt-logo.png" Width="28" Height="28" Stretch="Uniform" />
                        <TextBlock Text="KMTGuard" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowCloseButton}"
                            HorizontalAlignment="Right"
                            Height="51"
                            Click="CloseWindowButton_Click"
                            ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F1F7FD" Offset="0" />
                            <GradientStop Color="#E8F1FB" Offset="0.64" />
                            <GradientStop Color="#F9F5EA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="32">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="22" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <Image Source="Assets/Brand/kmt-logo.png" Width="90" Height="90" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="KMTGuard" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" Margin="0,24,0,0" />
                            <TextBlock Text="Server operations, without the clutter." Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Border Width="34" Height="3" Background="{StaticResource BrandGoldBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,9" />
                            <TextBlock Text="SECURE ADMINISTRATION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandGoldBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="42,34,42,34">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome back" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                        <TextBlock Text="Sign in to open the operations workspace." Style="{StaticResource MutedText}" Margin="0,6,0,24" />

                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameBox" Text="owner" Margin="0,0,0,16" />

                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20" />

                        <Button Height="42" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource FluentIcon}" Foreground="White" />
                                <TextBlock Text="Sign in" Foreground="White" />
                            </StackPanel>
                        </Button>

                        <Border x:Name="ErrorPanel" Background="{StaticResource RoseSoftBrush}" BorderBrush="#F0C4CB" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" TextWrapping="Wrap" FontSize="11.5" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="KMTGUARD CONTROL CENTER" Foreground="{StaticResource SubtleTextBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
