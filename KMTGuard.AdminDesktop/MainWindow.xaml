                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1"
                                       Text="Required Silk is the total account Silk spent anywhere: stock/custom malls, Silk NPCs, stalls, and other features. Leave Optional Buff Skill empty to give only the icon. Skill code names are validated against the active shard before saving."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       LineHeight="18" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Panel}" Padding="0">
                            <DataGrid x:Name="VipTiersGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RANK"
                                                        Binding="{Binding DisplayName}"
                                                        IsReadOnly="True"
                                                        Width="120" />
                                    <DataGridTextColumn Header="ICON ID"
                                                        Binding="{Binding IconID}"
                                                        IsReadOnly="True"
                                                        Width="80" />
                                    <DataGridTextColumn Header="ICON FILE"
                                                        Binding="{Binding IconPath}"
                                                        IsReadOnly="True"
                                                        Width="*" />
                                    <DataGridTextColumn Header="REQUIRED SILK"
                                                        Binding="{Binding MinSilk, UpdateSourceTrigger=LostFocus}"
                                                        Width="140" />
                                    <DataGridTextColumn Header="OPTIONAL BUFF SKILL"
                                                        Binding="{Binding BuffSkillCode, UpdateSourceTrigger=LostFocus}"
                                                        Width="260" />
                                    <DataGridTextColumn Header="PLAYERS"
                                                        Binding="{Binding AssignedPlayers}"
                                                        IsReadOnly="True"
                                                        Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="CURRENT PLAYER RANKING"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="2,14,0,8" />

                        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
                            <DataGrid x:Name="VipPlayersGrid"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VipSystemStatusText"
                                   Text="Load the VIP tier configuration to begin."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="VIP enable/disable takes effect after Filter restart"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <Grid x:Name="EconomyLogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Economy Logs" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="EconomySearchBox" Width="240" Style="{StaticResource InputBox}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadLuckyLogButton_Click" Margin="0,0,8,0"><TextBlock Text="Lucky" /></Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadOfferLogButton_Click" Margin="0,0,8,0"><TextBlock Text="Offers" /></Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadSilkStallLogButton_Click"><TextBlock Text="Silk Stall" /></Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="EconomyLogsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" />
                    </Border>
                </Grid>

                <Grid x:Name="AutoEventsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xECA7;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Auto Events" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadAutoEventConfigButton_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Refresh" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Click="ReloadAutoEventButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Reload Engine" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Event Setup" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Choose event to edit" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="AutoEventPickerBox"
                                              Height="42"
                                              SelectionChanged="AutoEventPickerBox_SelectionChanged"
                                              Margin="0,0,0,5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding [DisplayName]}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="The editor below updates immediately when you choose an event."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Event code" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AutoEventCodeBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,10" />
                                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AutoEventDisplayNameBox" Text="Retype Event" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Warm-up sec" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventStartDelayBox" Text="60" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="HWID limit" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventHwidLimitBox" Text="1" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Rounds" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventRoundCountBox" Text="3" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Duration sec" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventRoundDurationBox" Text="45" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Between rounds sec" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventDelayBox" Text="10" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Min level" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventMinLevelBox" Text="1" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Cooldown ms" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventCooldownBox" Text="750" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel x:Name="AutoEventAlchemyPanel" Margin="6,0,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Alchemy + target" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="AutoEventAlchemyPlusBox" Text="7" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="AutoEventEnabledBox" Content="Enabled" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <CheckBox x:Name="AutoEventUniqueWinnerBox" Content="Unique winner per run" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <CheckBox x:Name="AutoEventRequireHwidBox" Content="Require HWID uniqueness" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <Button Style="{StaticResource PrimaryButton}" Click="SaveAutoEventConfigButton_Click" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save Event" /></StackPanel>
                                    </Button>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <Button Style="{StaticResource PrimaryButton}" Click="StartAutoEventButton_Click" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Start" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Click="StopAutoEventButton_Click" Margin="6,0,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Stop" /></StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <TextBlock x:Name="AutoEventStatusText" Text="Choose an event above to begin editing." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <TabControl>
                                <TabItem Header="Events">
                                    <DockPanel Margin="0,14,0,0">
                                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <TextBlock Text="Select an event" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Click any row once. The Event Setup panel on the left will load it automatically."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <DataGrid x:Name="AutoEventsGrid"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  SelectionChanged="AutoEventsGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Event" Binding="{Binding [EventCode]}" Width="130" />
                                                <DataGridTextColumn Header="Display name" Binding="{Binding [DisplayName]}" Width="*" />
                                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding [Enabled]}" Width="80" />
                                                <DataGridTextColumn Header="Warm-up" Binding="{Binding [StartDelaySeconds]}" Width="85" />
                                                <DataGridTextColumn Header="Rounds" Binding="{Binding [RoundCount]}" Width="75" />
                                                <DataGridTextColumn Header="Duration" Binding="{Binding [RoundDurationSeconds]}" Width="85" />
                                                <DataGridTextColumn Header="Min level" Binding="{Binding [MinLevel]}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Schedule">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="350" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Add an automatic schedule" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Run once at the selected time, or repeat automatically from that time until the end of each selected day." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                                <TextBox x:Name="AutoEventScheduleIdBox" Visibility="Collapsed" />
                                                <TextBlock Text="Start time (24-hour clock)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="AutoEventScheduleTimeBox"
                                                         Text="20:00"
                                                         Style="{StaticResource InputBox}"
                                                         FontSize="20"
                                                         FontWeight="SemiBold"
                                                         HorizontalContentAlignment="Center"
                                                         AutomationProperties.HelpText="Enter a time from 00:00 to 23:59"
                                                         Margin="0,0,0,10" />
                                                <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="AutoEventScheduleRepeatBox"
                                                          Height="40"
                                                          SelectedValuePath="Tag"
                                                          SelectedIndex="0"
                                                          Margin="0,0,0,5">
                                                    <ComboBoxItem Content="Once per selected day" Tag="0" />
                                                    <ComboBoxItem Content="Every 30 minutes" Tag="30" />
                                                    <ComboBoxItem Content="Every hour" Tag="60" />
                                                    <ComboBoxItem Content="Every 2 hours" Tag="120" />
                                                    <ComboBoxItem Content="Every 3 hours" Tag="180" />
                                                    <ComboBoxItem Content="Every 4 hours" Tag="240" />
                                                    <ComboBoxItem Content="Every 6 hours" Tag="360" />
                                                </ComboBox>
                                                <TextBlock Text="A 15-minute safety gap is enforced between all automatic events. Conflicting schedules cannot be saved."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,14" />
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Run on" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="7,3" Tag="Auto:EveryDay" Click="ScheduleDaysPresetButton_Click"><TextBlock Text="Every day" /></Button>
                                                        <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="7,3" Tag="Auto:Weekends" Click="ScheduleDaysPresetButton_Click"><TextBlock Text="Weekend" /></Button>
                                                        <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="7,3" Tag="Auto:Clear" Click="ScheduleDaysPresetButton_Click"><TextBlock Text="Clear" /></Button>
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <ToggleButton x:Name="AutoEventScheduleSunBox" Content="Sun" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleMonBox" Content="Mon" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleTueBox" Content="Tue" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleWedBox" Content="Wed" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleThuBox" Content="Thu" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleFriBox" Content="Fri" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="AutoEventScheduleSatBox" Content="Sat" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                </WrapPanel>
                                                <CheckBox x:Name="AutoEventScheduleActiveBox"
                                                          Content="Active schedule (off saves it paused)"
                                                          IsChecked="True"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,0,4" />
                                                <TextBlock Text="Paused schedules stay saved for later but never start automatically."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,14" />
                                                <Button Style="{StaticResource PrimaryButton}" Click="SaveAutoEventScheduleButton_Click" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock x:Name="AutoEventScheduleSaveText" Text="Add Time" /></StackPanel>
                                                </Button>
                                                <UniformGrid Columns="2">
                                                    <Button Style="{StaticResource SecondaryButton}" Click="NewAutoEventScheduleButton_Click" Margin="0,0,5,0"><TextBlock Text="New Time" /></Button>
                                                    <Button Style="{StaticResource DangerButton}" Click="DeleteAutoEventScheduleButton_Click" Margin="5,0,0,0"><TextBlock Text="Delete" /></Button>
                                                </UniformGrid>
                                            </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                        <DockPanel Grid.Column="2">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <TextBlock Text="Automatic schedules" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Select a row to edit it. Repeating schedules create each run automatically."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <DataGrid x:Name="AutoEventSchedulesGrid"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      SelectionChanged="AutoEventSchedulesGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Time" Binding="{Binding [StartTime]}" Width="95" />
                                                    <DataGridTextColumn Header="Repeat" Binding="{Binding [RepeatText]}" Width="125" />
                                                    <DataGridTextColumn Header="Days" Binding="{Binding [Days]}" Width="*" />
                                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding [IsActive]}" Width="90" />
                                                    <DataGridTextColumn Header="Last run" Binding="{Binding [LastRun]}" Width="140" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Questions">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Question / prompt" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Content ID" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoContentIdBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,8" />
                                            <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoContentPromptBox" Style="{StaticResource InputBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,8" />
                                            <TextBlock Text="Answer" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoContentAnswerBox" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <TextBlock Text="Weight" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoContentWeightBox" Text="10" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AutoContentActiveBox" Content="Active" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Button Style="{StaticResource PrimaryButton}" Click="SaveAutoContentButton_Click" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save Question" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Click="NewAutoContentButton_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" /><TextBlock Text="New Question" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <DockPanel Grid.Column="2">
                                            <TextBlock DockPanel.Dock="Top" Text="Questions for selected event" Style="{StaticResource SectionTitle}" />
                                            <DataGrid x:Name="AutoEventContentGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="AutoEventContentGrid_MouseDoubleClick" />
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Rewards">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Event reward" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Reward ID" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoRewardIdBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,8" />
                                            <TextBlock Text="Placement" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoRewardPlacementBox" Text="1" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <TextBlock Text="Reward type" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="AutoRewardTypeBox" Height="40" Margin="0,0,0,8" SelectedIndex="0">
                                                <ComboBoxItem Content="SilkOwn" />
                                                <ComboBoxItem Content="SilkGift" />
                                                <ComboBoxItem Content="SilkPoint" />
                                                <ComboBoxItem Content="Gold" />
                                                <ComboBoxItem Content="ItemChest" />
                                            </ComboBox>
                                            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoRewardAmountBox" Text="10" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <TextBlock Text="Item ID / Count / Plus" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                                <TextBox x:Name="AutoRewardItemIdBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,6,0" />
                                                <TextBox x:Name="AutoRewardItemCountBox" Text="1" Style="{StaticResource InputBox}" Margin="0,0,6,0" />
                                                <TextBox x:Name="AutoRewardPlusBox" Text="0" Style="{StaticResource InputBox}" />
                                            </UniformGrid>
                                            <TextBlock Text="Item CodeName128" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AutoRewardCodeNameBox" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AutoRewardActiveBox" Content="Active" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Button Style="{StaticResource PrimaryButton}" Click="SaveAutoRewardButton_Click" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save Reward" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Click="NewAutoRewardButton_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" /><TextBlock Text="New Reward" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <DockPanel Grid.Column="2">
                                            <TextBlock DockPanel.Dock="Top" Text="Rewards for selected event" Style="{StaticResource SectionTitle}" />
                                            <DataGrid x:Name="AutoEventRewardsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="AutoEventRewardsGrid_MouseDoubleClick" />
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Unique Rewards" Visibility="Collapsed">
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Unique kill reward" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Reward ID" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UniqueRewardIdBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,8" />
                                            <TextBlock Text="Mob ID" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UniqueMobIdBox" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <TextBlock Text="Reward type" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="UniqueRewardTypeBox" Height="40" Margin="0,0,0,8" SelectedIndex="0">
                                                <ComboBoxItem Content="SilkOwn" />
                                                <ComboBoxItem Content="SilkGift" />
                                                <ComboBoxItem Content="SilkPoint" />
                                                <ComboBoxItem Content="Gold" />
                                                <ComboBoxItem Content="ItemChest" />
                                            </ComboBox>
                                            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UniqueRewardAmountBox" Text="10" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                            <TextBlock Text="Item ID / Count / Plus" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="3" Margin="0,0,0,8">
