<Window x:Class="KMTGuard.AdminDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KMTGuard Control Center"
        Width="1440"
        Height="880"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/Brand/kmt.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Opacity="0"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        StateChanged="MainWindow_StateChanged"
        ContentRendered="MainWindow_ContentRendered"
        Closing="MainWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource WindowFrameBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="0.985" ScaleY="0.985" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="286" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="18,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/Brand/kmt-logo.png" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="KMTGuard" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" />
                            <TextBlock Text="SERVER OPERATIONS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrandGoldBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="3" Height="20" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,11,0" />
                        <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="LOCAL SERVER" Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource WindowCommandButton}"
                                Click="MinimizeWindowButton_Click"
                                ToolTip="Minimize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCommandButton}"
                                Click="MaximizeWindowButton_Click"
                                ToolTip="Maximize or restore"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="MaximizeGlyphText" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Click="CloseWindowButton_Click"
                                ToolTip="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#E5DDCF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                            <ListBox x:Name="NavigationGroupList"
                                     ItemContainerStyle="{StaticResource NavRailItemStyle}"
                                     SelectionChanged="NavigationGroupList_SelectionChanged"
                                     HorizontalContentAlignment="Center"
                                     Margin="0,16,0,0">
                                <ListBoxItem Tag="Workspace" IsSelected="True" ToolTip="Workspace">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="OperationsNavigationGroupItem" Tag="Operations" ToolTip="Operations">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="EventsNavigationGroupItem" Tag="Events" ToolTip="Event automation">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="ContentNavigationGroupItem" Tag="Content" ToolTip="Content and economy">
                                    <TextBlock Text="&#xE8EC;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="BotOperationsNavigationGroupItem" Tag="BotOperations" ToolTip="Bot operations">
                                    <TextBlock Text="&#xE99A;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="SystemGameNavigationGroupItem" Tag="SystemGame" ToolTip="System game">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="NotificationsNavigationGroupItem" Tag="Notifications" ToolTip="Notifications">
                                    <TextBlock Text="&#xE7E7;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                                <ListBoxItem x:Name="SystemNavigationGroupItem" Tag="System" ToolTip="Data and system">
                                    <TextBlock Text="&#xE770;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </ListBoxItem>
                            </ListBox>
                        </Border>

                        <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top">
                            <Grid Margin="16,20,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="NavigationGroupTitleText" Text="Workspace" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                                    <TextBlock x:Name="NavigationGroupSubtitleText" Text="Daily server control" FontSize="10.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" CornerRadius="10" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavigationGroupCountText" Text="4" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Border Height="42"
                                    Margin="12,0,12,12"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource StrongLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="NavigationSearchHint"
                                                   Text="Find a workspace..."
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                        <TextBox x:Name="NavigationSearchBox"
                                                 AutomationProperties.Name="Search modules"
                                                 Style="{x:Null}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="12"
                                                 Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="NavigationSearchBox_TextChanged"
                                                 KeyDown="NavigationSearchBox_KeyDown" />
                                    </Grid>
                                    <Button x:Name="ClearNavigationSearchButton"
                                            Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Width="30"
                                            Height="30"
                                            MinHeight="30"
                                            Padding="0"
                                            Visibility="Collapsed"
                                            Click="ClearNavigationSearchButton_Click"
                                            ToolTip="Clear search">
                                        <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Margin="12"
                                Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminNameText" Text="Owner" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Administrator" Foreground="{StaticResource SubtleTextBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="SidebarStatusDot" Width="7" Height="7" Fill="{StaticResource SubtleTextBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <TextBlock x:Name="SidebarStatusText"
                                               Grid.Column="1"
                                               Text="Connection not checked"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               LineHeight="16"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="34" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                        <ListBox x:Name="NavigationList"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="NavigationList_SelectionChanged">
                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="WORKSPACE" />
                    <ListBoxItem Tag="Dashboard" IsSelected="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Dashboard" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Setup">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Setup &amp; Health" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Connection">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Connection" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Players">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Players" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="OPERATIONS" />
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Filter Settings" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="GameServerPatch">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Gameserver Patch" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Runtime">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Runtime Actions" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PlayerCommands">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Player Commands" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Security">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Security" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PacketRules">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Packet Rules" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="EVENT AUTOMATION" />
                    <ListBoxItem Tag="AutoEvents">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xECA7;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Auto Events" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="SurvivalParty">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Survival Party" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="SurvivalSolo">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Survival Solo" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="HideAndSeek">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Hide and Seek" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="LastManStanding">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Last Man Standing" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="MadnessSolo">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Madness Solo" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="DefendTower">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Defend The Tower" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="CONTENT &amp; ECONOMY" />
                    <ListBoxItem Tag="Rewards">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Rewards" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="LuckySpin">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Lucky Spin" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="SpecialOffers">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Special Offers" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="KillerAnimations">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Killer Animations" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="VipSystem">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" Style="{StaticResource FluentIcon}" /><TextBlock Text="VIP System" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="EconomyLogs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Economy Logs" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PvpChallenge">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="PvP Challenge" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="BOT OPERATIONS" />
                    <ListBoxItem Tag="ClientlessOverview">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Overview" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ClientlessProvisioning">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FA;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Create Accounts" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ClientlessRuntime">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Run by City" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ClientlessAccounts">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE910;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Accounts &amp; Status" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ClientlessHunting">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Hunting Areas" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ClientlessParty">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE902;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Party Matching" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="SYSTEM &amp; GAME" />
                    <ListBoxItem Tag="UniqueRules">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Unique Rules" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="RegionControl">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81E;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Region Control" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Scheduler">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Scheduler" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="WebViewer">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Web Buttons" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="NOTIFICATIONS" />
                    <ListBoxItem Tag="Discord">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Discord Notifications" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Telegram">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Telegram Notifications" /></StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource NavSectionStyle}" Content="DATA &amp; SYSTEM" />
                    <ListBoxItem Tag="Diagnostics">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" /><TextBlock Text="System Health" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Migrations">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Database Updates" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ChatLogs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Chat History" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Logs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Service Logs" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Audit">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Audit Log" /></StackPanel>
                    </ListBoxItem>
                        </ListBox>
                        <StackPanel x:Name="NavigationNoResultsPanel"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Margin="18">
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource SubtleTextBrush}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No workspace found" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="Try another keyword" FontSize="10.5" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                        </Grid>
                        </DockPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="30,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="KMTGUARD" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="  /  " Foreground="{StaticResource SubtleTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="HeaderSectionText" Text="WORKSPACE" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="  /  " Foreground="{StaticResource SubtleTextBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="HeaderTitleText" Text="Dashboard" Foreground="{StaticResource TextStrongBrush}" FontSize="10" FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock x:Name="HeaderSubtitleText"
                                           Text="Live server and database status"
                                           FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TopRuntimeStatusDot" Width="7" Height="7" Fill="{StaticResource SubtleTextBrush}" Margin="0,0,7,0" />
                                        <TextBlock Text="ENGINE" Foreground="{StaticResource SubtleTextBrush}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TopRuntimeStatusText" Text="Not checked" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TopSqlStatusDot" Width="7" Height="7" Fill="{StaticResource SubtleTextBrush}" Margin="0,0,7,0" />
                                        <TextBlock Text="SQL" Foreground="{StaticResource SubtleTextBrush}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text, ElementName=MetricSqlStatus}" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource IconButton}" Click="RefreshButton_Click" Margin="0,0,8,0" ToolTip="Refresh current workspace">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Click="TestSqlButton_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE930;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Test SQL" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="PageHost" Grid.Row="1" Margin="30,24,30,22">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PageHostTransform" />
                        </Grid.RenderTransform>
                <Grid x:Name="DashboardPage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TODAY AT A GLANCE" Style="{StaticResource EyebrowText}" Margin="0,0,0,5" />
                                    <TextBlock Text="Operations desk" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="The things that need a decision, with the detail one click away."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="DashboardUpdatedText"
                                               Text="Waiting for first refresh"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Button Style="{StaticResource GhostButton}" Click="OpenSetupButton_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" />
                                            <TextBlock Text="Setup &amp; health" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" />
                                            <TextBlock Text="Refresh brief" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="DashboardSetupBanner"
                                    Background="#E9DECB"
                                    BorderBrush="#D1BE9D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="24,21"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Complete your server setup" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                                        <TextBlock Text="KMTGuard will verify SQL access, runtime files, required database components, and all three services before unlocking the complete workspace."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,22,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Click="OpenSetupButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76C;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Continue guided setup" Foreground="White" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="CopySupportReportButton_Click" Margin="0,7,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Copy support report" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="DashboardPosturePanel"
                                    Background="#E9DECB"
                                    BorderBrush="#D1BE9D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentBrush}" />

                                    <StackPanel Grid.Column="1" Margin="24,22,26,22">
                                        <TextBlock Text="SERVER POSTURE"
                                                   Foreground="{StaticResource BrandGoldBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                        <TextBlock x:Name="DashboardSystemHeadlineText"
                                                   Text="Checking server posture"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0" />
                                        <TextBlock x:Name="DashboardDbText"
                                                   Text="Load Settings.json and test the connection."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,17" />
                                        <WrapPanel>
                                            <Border Background="#FFFBF4" BorderBrush="#D7C8B2" BorderThickness="1" CornerRadius="12" Padding="11,7" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DashboardSqlStatusDot" Width="8" Height="8" Fill="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="SQL" Foreground="{StaticResource SubtleTextBrush}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="MetricSqlStatus" Text="Not checked" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFBF4" BorderBrush="#D7C8B2" BorderThickness="1" CornerRadius="12" Padding="11,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DashboardRuntimeStatusDot" Width="8" Height="8" Fill="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="ENGINE" Foreground="{StaticResource SubtleTextBrush}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DashboardRuntimeStatusText" Text="Not checked" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#D1BE9D" Margin="0,22" />

                                    <Grid Grid.Column="3" Margin="26,20,26,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                             <RowDefinition Height="Auto" />
                                             <RowDefinition Height="1" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>
                                        <TextBlock Text="LIVE CAPACITY" Foreground="{StaticResource BrandGoldBrush}" FontSize="10" FontWeight="Bold" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock x:Name="DashboardOnlinePlayersText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                                            <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource SubtleTextBrush}" Margin="5,9,5,0" />
                                            <TextBlock x:Name="DashboardLicensedPlayersText" Text="-" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Margin="0,8,0,14">
                                            <ProgressBar x:Name="DashboardCapacityBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                                            <TextBlock x:Name="DashboardCapacityText" Text="Waiting for the Agent service" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,7,0,0" />
                                        </StackPanel>
                                        <Border Grid.Row="3" Background="#D1BE9D" />
                                        <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                            <TextBlock Text="SUBSCRIPTION" Foreground="{StaticResource BrandGoldBrush}" FontSize="9.5" FontWeight="Bold" />
                                            <TextBlock x:Name="DashboardSubscriptionRemainingText" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock x:Name="DashboardSubscriptionExpiresText" Text="-" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid x:Name="DashboardServicesPanel" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Panel}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="20,17,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SERVICE LEDGER" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="The three filter processes" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <TextBlock x:Name="DashboardRuntimeDetailText" Text="Service status has not been checked yet." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock x:Name="DashboardRunningServicesText" Text="0 / 3" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="RUNNING" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
                                        <ItemsControl x:Name="DashboardServiceList" Grid.Row="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="20,11">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.75*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="ServiceStateDot" Width="8" Height="8" Fill="{StaticResource RoseBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Role}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Sessions, StringFormat={}{0:N0} sessions}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding MemoryMb, StringFormat={}{0:N1} MB}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter TargetName="ServiceStateDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.Row="3" Background="{StaticResource LineBrush}" />
                                         <Grid Grid.Row="4" Margin="18,13">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <StackPanel VerticalAlignment="Center">
                                                 <TextBlock Text="PLAYER NOTICE LANGUAGE" Style="{StaticResource EyebrowText}" />
                                                 <TextBlock x:Name="PlayerLanguageStatusText"
                                                            Text="Select the language used by Filter notices."
                                                            Style="{StaticResource MutedText}"
                                                            Margin="0,3,12,0" />
                                             </StackPanel>
                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <ComboBox x:Name="PlayerLanguageBox" Width="142" Height="34" SelectedIndex="0">
                                                     <ComboBoxItem Content="English" Tag="English" />
                                                     <ComboBoxItem Content="T&#x00FC;rk&#x00E7;e" Tag="Turkish" />
                                                 </ComboBox>
                                                 <Button x:Name="ApplyPlayerLanguageButton"
                                                         Style="{StaticResource SecondaryButton}"
                                                         Click="ApplyPlayerLanguageButton_Click"
                                                         Margin="8,0,0,0">
                                                     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Apply" /></StackPanel>
                                                 </Button>
                                             </StackPanel>
                                         </Grid>
                                         <Border Grid.Row="5" Background="{StaticResource LineBrush}" />
                                         <Grid Grid.Row="6" Margin="18,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButton}" Click="StartFilterButton_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Start all" /></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Click="RestartFilterButton_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Restart" /></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DangerButton}" Click="StopFilterButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Stop" /></StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Tag="Runtime" Click="NavigateToPageButton_Click" Padding="9,5" MinHeight="30">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Full console" /><TextBlock Text="&#xE76C;" Style="{StaticResource FluentIcon}" Margin="7,0,0,0" /></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,17,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ATTENTION DESK" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="What deserves a look" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" CornerRadius="11" Padding="9,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="DashboardAttentionCountText" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
                                        <ItemsControl x:Name="DashboardAttentionList" Grid.Row="2" Margin="18,7,18,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="AttentionStripe" Width="3" Background="{StaticResource AmberBrush}" CornerRadius="2" />
                                                        <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Tag="{Binding TargetPage}" Click="NavigateToPageButton_Click" Padding="7,4" MinHeight="28" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE76C;" Style="{StaticResource FluentIcon}" Margin="0" />
                                                        </Button>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter TargetName="AttentionStripe" Property="Background" Value="{StaticResource RoseBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Healthy">
                                                            <Setter TargetName="AttentionStripe" Property="Background" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="DashboardReadinessPanel" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.82*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.18*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Panel}" Padding="0">
                                    <StackPanel>
                                        <Grid Margin="18,17,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="READINESS" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="Database &amp; configuration" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Tag="Diagnostics" Click="NavigateToPageButton_Click" Padding="8,4" MinHeight="28">
                                                <TextBlock Text="Inspect" />
                                            </Button>
                                        </Grid>
                                        <Border Background="{StaticResource LineBrush}" Height="1" />
                                        <Grid Margin="18,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SETTINGS" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock x:Name="MetricSettings" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
                                            <StackPanel Grid.Column="2" Margin="14,0">
                                                <TextBlock Text="PENDING" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock x:Name="MetricCommands" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="{StaticResource LineBrush}" />
                                            <StackPanel Grid.Column="4" Margin="14,0,0,0">
                                                <TextBlock Text="INVALID" Foreground="{StaticResource SubtleTextBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock x:Name="MetricInvalid" Text="0" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="{StaticResource LineBrush}" Height="1" />
                                        <StackPanel Margin="18,14,18,18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Feature readiness" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DashboardModuleReadinessText" Grid.Column="1" Text="—" Foreground="{StaticResource MutedBrush}" />
                                            </Grid>
                                            <ProgressBar x:Name="DashboardModuleProgress" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" />
                                            <TextBlock x:Name="DashboardModulesDetailText" Text="Waiting for database diagnostics." Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,17,18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="AUTOMATION BOARD" Style="{StaticResource EyebrowText}" />
                                                <TextBlock Text="Events and scheduled work" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="DashboardActiveEventsText" Text="0 events" FontWeight="SemiBold" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource StrongLineBrush}" />
                                                <TextBlock x:Name="DashboardSchedulesText" Text="0 schedules" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
                                        <DataGrid x:Name="DashboardUpcomingEventsGrid"
                                                  Grid.Row="2"
                                                  Height="166"
                                                  Margin="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="EVENT" Binding="{Binding Event}" Width="*" />
                                                <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="85" />
                                                <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="145" />
                                                <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="DashboardActivityPanel" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="18,16,18,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="RECENT ADMIN ACTIVITY" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="A short, readable audit trail" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Tag="Audit" Click="NavigateToPageButton_Click" Padding="8,4" MinHeight="28">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Open full audit" /><TextBlock Text="&#xE76C;" Style="{StaticResource FluentIcon}" Margin="7,0,0,0" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{StaticResource LineBrush}" />
                                    <DataGrid x:Name="DashboardRecentActivityGrid"
                                              Grid.Row="2"
                                              Height="190"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="145" />
                                            <DataGridTextColumn Header="ADMIN" Binding="{Binding Admin}" Width="120" />
                                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="180" />
                                            <DataGridTextColumn Header="TARGET / RESULT" Binding="{Binding Detail}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border x:Name="DashboardWorkspaceMapPanel"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource StrongLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="WORKSPACE MAP" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="Jump straight to the work" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Tag="Players" Click="NavigateToPageButton_Click" Margin="0,0,8,0"><TextBlock Text="Players" /></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="PlayerCommands" Click="NavigateToPageButton_Click" Margin="0,0,8,0"><TextBlock Text="Player commands" /></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="AutoEvents" Click="NavigateToPageButton_Click" Margin="0,0,8,0"><TextBlock Text="Events" /></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="Security" Click="NavigateToPageButton_Click" Margin="0,0,8,0"><TextBlock Text="Protection" /></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="Diagnostics" Click="NavigateToPageButton_Click" Margin="0,0,8,0"><TextBlock Text="System health" /></Button>
                                        <Button Style="{StaticResource SecondaryButton}" Tag="Logs" Click="NavigateToPageButton_Click"><TextBlock Text="Logs" /></Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
