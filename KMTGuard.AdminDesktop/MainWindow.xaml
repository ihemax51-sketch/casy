                            <Button Style="{StaticResource SecondaryButton}" Click="LoadWhitelistButton_Click" Margin="0,0,8,0"><TextBlock Text="Whitelist" /></Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadBlacklistButton_Click"><TextBlock Text="Blacklist" /></Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Add rule" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Active rule table" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PacketTableBox" Text="[dbo].[Security_Whitelist]" IsReadOnly="True" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Server type" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PacketServerTypeBox" Text="1" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="MsgId decimal or hex 0x1234" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PacketMsgIdBox" Style="{StaticResource InputBox}" Margin="0,0,0,14" />
                                <Button Style="{StaticResource PrimaryButton}" Click="AddPacketRuleButton_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Add Rule" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <DataGrid x:Name="PacketRulesGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" />
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="DataStudioPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Data Studio" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="LoadDataStudioButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="410" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Managed Tables" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Advanced tables that still need clean admin access." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                </StackPanel>
                                <ListBox x:Name="AdvancedTablesList" SelectionChanged="AdvancedTablesList_SelectionChanged" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock x:Name="ManagedTableTitleText" Text="Choose a table" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ManagedTableNotesText" Text="Select a managed table to edit its fields." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Style="{StaticResource SecondaryButton}" Click="NewManagedRowButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" /><TextBlock Text="New" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Click="SaveManagedRowButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Click="DeleteManagedRowButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Delete" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ManagedFormPanel" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Panel}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ManagedSearchBox" Style="{StaticResource InputBox}" Height="36" Padding="10,6" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="SearchManagedRowsButton_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Search" /></StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" x:Name="ManagedStatusText" Text="Double click a row to edit it." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <DataGrid x:Name="ManagedRowsGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          MouseDoubleClick="ManagedRowsGrid_MouseDoubleClick" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="AuditPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Audit Log" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="LoadAuditButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="AuditGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" />
                    </Border>
                </Grid>

                <Grid x:Name="ClientlessPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ClientlessPageIconText" Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock x:Name="ClientlessPageTitleText" Text="Runtime Control" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Click="LoadClientlessButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Refresh" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ClientlessPageDescriptionText"
                               Grid.Row="1"
                               Text="Start, reload, and stop clientless runtime sessions."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />
                    <Border x:Name="ClientlessDefaultsPanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Expander Header="Advanced connection defaults" IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Most customers can leave these values unchanged. They are shared by account creation, import, and manual edits." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Default shard" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessShardBox" Text="64" Style="{StaticResource InputBox}" /></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Locale" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessLocaleBox" Text="22" Style="{StaticResource InputBox}" /></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Launch delay ms" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessLaunchDelayBox" Text="1000" Style="{StaticResource InputBox}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Reconnect seconds" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessReconnectBox" Text="30" Style="{StaticResource InputBox}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Grid Grid.Row="3" MinHeight="0">
                            <ScrollViewer x:Name="ClientlessOverviewSection"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <UniformGrid Columns="5" Margin="0,0,0,14">
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="Total accounts" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ClientlessTotalAccountsText" Text="0" Style="{StaticResource MetricValue}" /><TextBlock Text="Saved clientless accounts" Style="{StaticResource MutedText}" /></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="Enabled" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ClientlessEnabledAccountsText" Text="0" Style="{StaticResource MetricValue}" /><TextBlock Text="Allowed to start" Style="{StaticResource MutedText}" /></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="Ready" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ClientlessReadyAccountsText" Text="0" Style="{StaticResource MetricValue}" /><TextBlock Text="Game account and character found" Style="{StaticResource MutedText}" /></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="Online" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ClientlessOnlineAccountsText" Text="0" Style="{StaticResource MetricValue}" /><TextBlock Text="Currently connected" Style="{StaticResource MutedText}" /></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource KpiCard}">
                                            <StackPanel><TextBlock Text="Needs attention" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ClientlessAttentionAccountsText" Text="0" Style="{StaticResource MetricValue}" Foreground="{StaticResource AmberBrush}" /><TextBlock Text="Missing or disconnected" Style="{StaticResource MutedText}" /></StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Panel}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                    <TextBlock Text="Accounts by city" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="See what exists, what is ready, and what is online before starting a city." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <DataGrid x:Name="ClientlessCitySummaryGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" MinHeight="300" />
                                            </DockPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="What do you want to do?" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Use these shortcuts in order. No SQL or code is required." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                                <Button Tag="ClientlessProvisioning" Style="{StaticResource PrimaryButton}" Click="NavigateToPageButton_Click" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="1. Create Accounts" /></StackPanel>
                                                </Button>
                                                <Button Tag="ClientlessAccounts" Style="{StaticResource SecondaryButton}" Click="NavigateToPageButton_Click" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE910;" Style="{StaticResource FluentIcon}" /><TextBlock Text="2. Check Accounts" /></StackPanel>
                                                </Button>
                                                <Button Tag="ClientlessRuntime" Style="{StaticResource SecondaryButton}" Click="NavigateToPageButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" /><TextBlock Text="3. Run Selected Cities" /></StackPanel>
                                                </Button>
                                                <Button Tag="ClientlessHunting" Style="{StaticResource SecondaryButton}" Click="NavigateToPageButton_Click" Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" /><TextBlock Text="4. Configure Hunting" /></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ClientlessRuntimeSection"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Border x:Name="ClientlessRuntimePanel" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource TealBrush}" />
                                        <TextBlock Text="Runtime control" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ClientlessRuntimeText" Text="Clientless is stopped." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="Choose each city and type exactly how many characters should hunt there. Every remaining ready character stays online in its city automatically." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Use" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="City" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="2" Text="Ready" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="3" Text="Hunters now" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="4" Text="In city now" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="5" Text="Online wanted" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="6" Text="Hunters wanted" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="7" Text="Result" Style="{StaticResource FieldLabel}" />
                                            </Grid>
                                            <ItemsControl x:Name="ClientlessCityPlansEditor">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="44" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding City}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ReadyAccounts}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding CurrentHunters}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{Binding CurrentParked}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="5" Text="{Binding DesiredOnlineText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="95" HorizontalAlignment="Left" />
                                                            <TextBox Grid.Column="6" Text="{Binding DesiredHuntersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="95" HorizontalAlignment="Left" />
                                                            <TextBlock Grid.Column="7" VerticalAlignment="Center" Foreground="{StaticResource TealBrush}" Text="Online minus hunters stay parked" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Style="{StaticResource SecondaryButton}" Click="SelectAllClientlessCityPlansButton_Click" Margin="0,0,8,0"><TextBlock Text="Select All" /></Button>
                                                <Button Style="{StaticResource SecondaryButton}" Click="ClearClientlessCityPlansButton_Click" Margin="0,0,8,0"><TextBlock Text="Clear Selection" /></Button>
                                                <Button Style="{StaticResource SecondaryButton}" Click="ApplyClientlessHunterCountButton_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Apply Plan Live" /></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Click="ParkSelectedClientlessCitiesButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Set Selected Cities to 0" /></StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="Example: Ready 50 + Hunters wanted 20 = 20 hunt and 30 stay in the city. Setting 0 returns everyone in that city to standby without disconnecting them." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Click="StartClientlessButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Apply Plan &amp; Start" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="ReloadClientlessButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Apply Plan &amp; Reload" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Click="StopClientlessButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Disconnect Selected" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ClientlessProvisioningSection"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <Border x:Name="ClientlessCreationPanel" Style="{StaticResource Panel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource TealBrush}" />
                                        <TextBlock Text="Create game-ready accounts" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Choose the character setup and enter how many accounts each city needs. Zero skips a city. Existing accounts are never replaced." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <TextBlock Text="1. Character setup" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Race" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkRaceBox" SelectedIndex="0" Height="40" SelectionChanged="ClientlessBulkRaceBox_SelectionChanged">
                                                <ComboBoxItem Content="Random" Tag="Random" />
                                                <ComboBoxItem Content="Chinese" Tag="Chinese" />
                                                <ComboBoxItem Content="European" Tag="Europe" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Weapon" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkWeaponBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Random" Tag="Random" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Gender" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkGenderBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Random" Tag="Random" />
                                                <ComboBoxItem Content="Male" Tag="Male" />
                                                <ComboBoxItem Content="Female" Tag="Female" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Equipment" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkEquipmentBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Rare (C_RARE)" Tag="Rare" />
                                                <ComboBoxItem Content="Normal for level" Tag="Normal" />
                                                <ComboBoxItem Content="No equipment" Tag="None" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Skills" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkSkillsBox" SelectedIndex="2" Height="40">
                                                <ComboBoxItem Content="Default skills" Tag="Default" />
                                                <ComboBoxItem Content="Open weapon mastery" Tag="Mastery" />
                                                <ComboBoxItem Content="Open masteries + max skills &amp; buffs" Tag="MasteryAndSkills" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,0">
                                            <TextBlock Text="Stat build" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkBuildBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Random STR / INT" Tag="Random" />
                                                <ComboBoxItem Content="Full STR" Tag="Strength" />
                                                <ComboBoxItem Content="Full INT" Tag="Intelligence" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,10,10,0">
                                            <TextBlock Text="Avatar outfit" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkAvatarsBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Enabled - varied avatars" Tag="Enabled" />
                                                <ComboBoxItem Content="Disabled - no avatar" Tag="Disabled" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,10,10,0">
                                            <TextBlock Text="Attack pet" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkAttackPetBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Enabled - varied attack pet" Tag="Enabled" />
                                                <ComboBoxItem Content="Disabled - no attack pet" Tag="Disabled" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Grab pet" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessBulkGrabPetBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Enabled - varied grab pet" Tag="Enabled" />
                                                <ComboBoxItem Content="Disabled - no grab pet" Tag="Disabled" />
                                            </ComboBox>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="The selected weapon automatically chooses its mastery. Max skills adds only the highest valid rank from each skill branch. Full STR or INT assigns every level-up point to that stat. Avatar, attack-pet, and grab-pet choices are independent and apply to this new batch." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <TextBlock Text="2. Accounts per city" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Jangan accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessJanganCountBox" Text="100" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Donwhang accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessDonwhangCountBox" Text="0" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Hotan accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessHotanCountBox" Text="0" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Samarkand accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessSamarkandCountBox" Text="0" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="Constantinople accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessConstantinopleCountBox" Text="0" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Alexandria North (SD) accounts" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessAlexandriaNorthCountBox" Text="0" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessBulkPasswordBox" Text="bot123" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Min level" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessBulkMinLevelBox" Text="1" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Max level" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessBulkMaxLevelBox" Text="1" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Click="BulkCreateClientlessButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Create Accounts" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PrepareExistingClientlessSkillsButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Prepare Existing Combat" /></StackPanel>
                                        </Button>
                                        <TextBlock x:Name="ClientlessBulkResultText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Separator Margin="0,20,0,14" />
                                    <Expander Header="Import existing accounts from a file">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="File columns: user, password, character name, and optional city. Tabs, spaces, commas, and semicolons are accepted." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox x:Name="ClientlessImportPathBox" Style="{StaticResource InputBox}" />
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="BrowseClientlessImportButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Browse" /></StackPanel>
                                                </Button>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButton}" Click="ImportClientlessButton_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Import File" /></StackPanel>
                                                </Button>
                                                <TextBlock x:Name="ClientlessImportResultText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ClientlessAccountsSection"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ClientlessAccountsPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource VioletBrush}" />
                                        <TextBlock Text="Manage selected account" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Account" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClientlessAccountBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClientlessPasswordBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <TextBlock Text="Character" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClientlessCharacterBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <TextBlock Text="City group" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ClientlessAccountCityBox" SelectedIndex="0" Height="40" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Unassigned / imported" Tag="Unassigned" />
                                        <ComboBoxItem Content="Jangan" Tag="Jangan" />
                                        <ComboBoxItem Content="Donwhang" Tag="Donwhang" />
                                        <ComboBoxItem Content="Hotan" Tag="Hotan" />
                                        <ComboBoxItem Content="SamarKand" Tag="SamarKand" />
                                        <ComboBoxItem Content="Constantinople" Tag="Constantinople" />
                                        <ComboBoxItem Content="Alexandria North (SD)" Tag="Alexandria North (SD)" />
                                    </ComboBox>
                                    <Button Style="{StaticResource PrimaryButton}" Click="SaveClientlessAccountButton_Click" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save Account" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Click="ToggleClientlessAccountButton_Click" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Enable / Disable Selected" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Click="DeleteClientlessAccountButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Delete Selected" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8A1;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Accounts list" Style="{StaticResource SectionTitle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Click="DeleteAllClientlessAccountsButton_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Clear All" /></StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Double-click an account to load it into the editor." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Grid>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ClientlessSearchBox" Style="{StaticResource InputBox}" Height="36" Padding="10,6" />
                                        <ComboBox x:Name="ClientlessAccountCityFilterBox" Grid.Column="2" SelectedIndex="0" Height="36">
                                            <ComboBoxItem Content="All cities" Tag="All" />
                                            <ComboBoxItem Content="Jangan" Tag="Jangan" />
                                            <ComboBoxItem Content="Donwhang" Tag="Donwhang" />
                                            <ComboBoxItem Content="Hotan" Tag="Hotan" />
                                            <ComboBoxItem Content="SamarKand" Tag="SamarKand" />
                                            <ComboBoxItem Content="Constantinople" Tag="Constantinople" />
                                            <ComboBoxItem Content="Alexandria North" Tag="Alexandria North (SD)" />
                                            <ComboBoxItem Content="Unassigned" Tag="Unassigned" />
                                        </ComboBox>
                                        <ComboBox x:Name="ClientlessAccountStateFilterBox" Grid.Column="4" SelectedIndex="0" Height="36">
                                            <ComboBoxItem Content="All states" Tag="All" />
                                            <ComboBoxItem Content="Ready" Tag="Ready" />
                                            <ComboBoxItem Content="Online" Tag="Online" />
                                            <ComboBoxItem Content="Needs attention" Tag="Attention" />
                                            <ComboBoxItem Content="Enabled" Tag="Enabled" />
                                            <ComboBoxItem Content="Disabled" Tag="Disabled" />
                                        </ComboBox>
                                        <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Click="LoadClientlessButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Search" /></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" x:Name="ClientlessGridStatusText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <DataGrid x:Name="ClientlessGrid"
                                              Height="380"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              GridLinesVisibility="Horizontal"
                                              MouseDoubleClick="ClientlessGrid_MouseDoubleClick" />
                                </DockPanel>
                            </Border>
                        </Grid>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ClientlessHuntingSection"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="0.65*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource TealBrush}" />
                                                    <TextBlock Text="Five hunting areas per city" Style="{StaticResource SectionTitle}" />
                                                </StackPanel>
                                                <TextBlock Text="Choose a city, type Region ID and X / Y / Z, set a safe radius, then enable only the areas you want to use. Accounts are distributed evenly between enabled areas."
                                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <TextBlock Text="City" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="ClientlessHuntCityBox" SelectedIndex="0" Height="40" Width="280" HorizontalAlignment="Left"
                                                          SelectionChanged="ClientlessHuntCityBox_SelectionChanged" Margin="0,0,0,12">
                                                    <ComboBoxItem Content="Jangan" Tag="Jangan" />
                                                    <ComboBoxItem Content="Donwhang" Tag="Donwhang" />
                                                    <ComboBoxItem Content="Hotan" Tag="Hotan" />
                                                    <ComboBoxItem Content="SamarKand" Tag="SamarKand" />
                                                    <ComboBoxItem Content="Constantinople" Tag="Constantinople" />
                                                    <ComboBoxItem Content="Alexandria North (SD)" Tag="Alexandria North (SD)" />
                                                </ComboBox>
                                                <!--
                                                    There are always exactly five rows, so a direct editor is both simpler for
                                                    operators and safer than DataGrid's transactional cell editor. Coordinates
                                                    remain text until Save; moving between fields never performs culture-sensitive
                                                    numeric conversion or a re-entrant DataGrid row commit on the UI thread.
                                                -->
                                                <Border Height="255" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="40" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Background="#F3EEE6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="1.5*" />
                                                                <ColumnDefinition Width="50" />
                                                                <ColumnDefinition Width="75" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="70" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource FieldLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="Area name" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="Use" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="Region" Style="{StaticResource FieldLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="X" Style="{StaticResource FieldLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="5" Text="Y" Style="{StaticResource FieldLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="6" Text="Z" Style="{StaticResource FieldLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="7" Text="Radius" Style="{StaticResource FieldLabel}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <ItemsControl x:Name="ClientlessHuntAreasEditor"
                                                                      Grid.Row="1"
                                                                      HorizontalContentAlignment="Stretch"
                                                                      KeyboardNavigation.TabNavigation="Continue">
                                                            <ItemsControl.Resources>
                                                                <Style x:Key="ClientlessHuntInlineEditor" TargetType="TextBox">
                                                                    <Setter Property="Height" Value="32" />
                                                                    <Setter Property="MinHeight" Value="0" />
                                                                    <Setter Property="Padding" Value="7,3" />
                                                                    <Setter Property="Margin" Value="3,4" />
                                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource StrongLineBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                </Style>
                                                            </ItemsControl.Resources>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Height="42" BorderBrush="#E9E0D4" BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="38" />
                                                                                <ColumnDefinition Width="1.5*" />
                                                                                <ColumnDefinition Width="50" />
                                                                                <ColumnDefinition Width="75" />
                                                                                <ColumnDefinition Width="65" />
                                                                                <ColumnDefinition Width="65" />
                                                                                <ColumnDefinition Width="65" />
                                                                                <ColumnDefinition Width="70" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding [Area]}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Column="1" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [Name], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <CheckBox Grid.Column="2" IsChecked="{Binding [Enabled], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <TextBox Grid.Column="3" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [RegionID], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="4" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [X], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="5" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [Y], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="6" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [Z], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                            <TextBox Grid.Column="7" Style="{StaticResource ClientlessHuntInlineEditor}"
                                                                                     Text="{Binding [Radius], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Combat behavior" Style="{StaticResource SectionTitle}" />
                                                    <CheckBox x:Name="ClientlessHuntNormalCheckBox" Content="Attack normal monsters" IsChecked="True" Margin="0,8,0,8" />
                                                    <CheckBox x:Name="ClientlessHuntUniqueCheckBox" Content="Attack uniques" IsChecked="True" Margin="0,0,0,8" />
                                                    <CheckBox x:Name="ClientlessHuntUniquePriorityCheckBox" Content="Prioritize uniques" IsChecked="True" Margin="0,0,0,8" />
                                                    <CheckBox x:Name="ClientlessHuntSkillsCheckBox" Content="Use learned attack skills" IsChecked="True" Margin="0,0,0,8" />
                                                    <CheckBox x:Name="ClientlessHuntBasicAttackCheckBox" Content="Use basic attack fallback" IsChecked="True" Margin="0,0,0,12" />
                                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="HP potion %" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessHuntHpBox" Text="60" Style="{StaticResource InputBox}" /></StackPanel>
                                                        <StackPanel><TextBlock Text="MP potion %" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessHuntMpBox" Text="40" Style="{StaticResource InputBox}" /></StackPanel>
                                                    </UniformGrid>
                                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Stuck seconds" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessHuntStuckBox" Text="15" Style="{StaticResource InputBox}" /></StackPanel>
                                                        <StackPanel><TextBlock Text="Target timeout" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ClientlessHuntTargetTimeoutBox" Text="30" Style="{StaticResource InputBox}" /></StackPanel>
                                                    </UniformGrid>
                                                    <Button Style="{StaticResource PrimaryButton}" Click="SaveEnableClientlessHuntingButton_Click" Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save &amp; Enable Hunting" /></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Click="SavePauseClientlessHuntingButton_Click">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE769;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Save &amp; Pause Hunting" /></StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Panel}">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Live hunting status" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock x:Name="ClientlessHuntStatusText" Text="Select a city to load its areas and accounts." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="EnableSelectedClientlessHuntButton_Click" VerticalAlignment="Center">
                                                    <TextBlock Text="Enable Selected" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource DangerButton}" Click="PauseSelectedClientlessHuntButton_Click" VerticalAlignment="Center">
                                                    <TextBlock Text="Pause Selected" />
                                                </Button>
                                            </Grid>
                                            <DataGrid x:Name="ClientlessHuntAccountsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" Height="280" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="ClientlessPartySection"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                        <Border x:Name="ClientlessPartyPanel" Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE902;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource VioletBrush}" />
                                        <TextBlock Text="Party Mode &amp; Matching" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Choose exactly how online Clientless characters use Party Matching. The selected mode is saved and applied again automatically after every login or reconnect."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Party operation mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ClientlessPartyModeBox"
                                              SelectedIndex="0"
                                              Height="42"
                                              Margin="0,0,0,8"
                                              SelectionChanged="ClientlessPartyModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Individual Party Form for every character" Tag="SoloForms" />
                                        <ComboBoxItem Content="Real parties of up to 8 characters" Tag="GroupsOf8" />
                                    </ComboBox>
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <TextBlock x:Name="ClientlessPartyModeHelpText"
                                                   Text="Every character stays outside managed parties and publishes its own Party Form."
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <Button x:Name="BuildClientlessPartiesButton" Style="{StaticResource SecondaryButton}" Click="BuildClientlessPartiesButton_Click" HorizontalAlignment="Left" Margin="0,0,0,8" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE902;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Create Parties of 8 Now" /></StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ClientlessPartyGroupingStatusText" Text="The manual rebuild button is available only in Groups of 8 mode." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,18" />
                                    <Separator Margin="0,0,0,16" />
                                    <TextBlock Text="Party Form details" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="These details are used for every individual form in Solo mode, or for the leader form in Groups of 8 mode."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Party name" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClientlessPartyTitleBox" Text="{}{CharacterName}" MaxLength="64" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Min level" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessPartyMinLevelBox" Text="1" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Max level" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ClientlessPartyMaxLevelBox" Text="140" Style="{StaticResource InputBox}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ClientlessPartyPurposeBox" SelectedIndex="0" Height="40">
                                                <ComboBoxItem Content="Hunting" Tag="0" />
                                                <ComboBoxItem Content="Trade / Hunter" Tag="2" />
                                                <ComboBoxItem Content="Thief" Tag="3" />
                                            </ComboBox>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="Party sharing" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ClientlessPartySettingsBox" SelectedIndex="3" Height="40" Margin="0,0,0,10">
                                        <ComboBoxItem Content="EXP Free / Item Free" Tag="4" />
                                        <ComboBoxItem Content="EXP Auto / Item Free" Tag="5" />
                                        <ComboBoxItem Content="EXP Free / Item Auto" Tag="6" />
                                        <ComboBoxItem Content="EXP Auto / Item Auto" Tag="7" />
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Click="EnableClientlessPartyFormButton_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save &amp; Apply Selected Mode" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Click="DisableClientlessPartyFormButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Disable &amp; Remove" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Current status" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="ClientlessPartyFormStatusText" Text="Party Form is disabled." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <TextBlock Text="Mode behavior" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="Individual Forms keeps every character separate and visible in Party Matching. Groups of 8 builds real parties per city and publishes only the confirmed leader's form. Switching mode clears the previous managed forms and parties first."
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <TextBlock Text="Tip: keep the account character level within the configured range and above the server minimum level."
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                            </ScrollViewer>
                    </Grid>
                    </Grid>

                <!-- Legacy runtime layout retained here for reference while the redesigned workspace settles.
                <Grid x:Name="RuntimePage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                                <TextBlock Text="Runtime Actions" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                             <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                                 <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                     </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="&#xE7C3;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" />
                                             <TextBlock Text="KMTGuard Services" Style="{StaticResource SectionTitle}" />
                                         </StackPanel>
                                         <TextBlock Text="Gateway, Download and Agent" Style="{StaticResource MutedText}" />
                                     </StackPanel>
                                     <Border Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BFE3D2" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE930;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource TealBrush}" />
                                            <TextBlock x:Name="FilterProcessStatusText" Text="Not checked" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                        </StackPanel>
                                     </Border>
                                     <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,10">
                                         <Button Style="{StaticResource PrimaryButton}" Click="StartFilterButton_Click" Margin="0,0,8,0">
                                             <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Start All" /></StackPanel>
                                         </Button>
                                         <Button Style="{StaticResource DangerButton}" Click="StopFilterButton_Click" Margin="0,0,8,0">
