                <Grid x:Name="SecurityPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                        <TextBlock Text="Security Center" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Chat filter" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Blocked word" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BlockedWordBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Match mode: 0 contains, 1 exact" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BlockedMatchModeBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <CheckBox x:Name="BlockedActiveBox" Content="Active" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,14" />
                                <Button Style="{StaticResource PrimaryButton}" Click="AddBlockedWordButton_Click" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Add Blocked Word" /></StackPanel>
                                </Button>
                                <Separator Margin="0,14,0,14" />
                                <TextBlock Text="HWID lookup" Style="{StaticResource SectionTitle}" />
                                <TextBox x:Name="HwidSearchBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <Button Style="{StaticResource SecondaryButton}" Click="SearchHwidButton_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Search HWID" /></StackPanel>
                                </Button>
                                <TextBlock Text="Double click an HWID row to deactivate by CharID." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Style="{StaticResource SecondaryButton}" Click="LoadBlockedWordsButton_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Blocked Words" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <DataGrid x:Name="SecurityGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="SecurityGrid_MouseDoubleClick" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="UniqueRulesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#xE734;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                        <TextBlock Text="Unique Rules" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Attack rule editor" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Unique ID (MobRefObjID)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="UniqueRuleMobIdBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <TextBlock Text="Allowed attackers" Style="{StaticResource FieldLabel}" />
                                    <CheckBox x:Name="UniqueRuleOffJobBox" Content="Off-job players" Margin="0,4,0,5" />
                                    <CheckBox x:Name="UniqueRuleOnJobBox" Content="Job-mode players" Margin="0,0,0,5" />
                                    <CheckBox x:Name="UniqueRuleThiefBox" Content="Thieves" Margin="0,0,0,5" />
                                    <CheckBox x:Name="UniqueRuleTraderBox" Content="Traders" Margin="0,0,0,5" />
                                    <CheckBox x:Name="UniqueRuleStrBox" Content="STR characters" Margin="0,0,0,5" />
                                    <CheckBox x:Name="UniqueRuleIntBox" Content="INT characters" Margin="0,0,0,10" />
                                    <TextBlock Text="Masks (0–255)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="UniqueRuleJobMaskBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                    <TextBox x:Name="UniqueRuleCapeMaskBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                                    <TextBox x:Name="UniqueRuleRaceMaskBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                    <TextBlock Text="Party / Guild requirement (-1 = any)" Style="{StaticResource FieldLabel}" />
                                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="UniqueRulePartyBox" Text="-1" Style="{StaticResource InputBox}" />
                                        <TextBox Grid.Column="2" x:Name="UniqueRuleGuildBox" Text="-1" Style="{StaticResource InputBox}" />
                                    </Grid>
                                    <UniformGrid Columns="3">
                                        <Button Style="{StaticResource SecondaryButton}" Click="NewUniqueRuleButton_Click" Margin="0,0,6,0">New</Button>
                                        <Button Style="{StaticResource PrimaryButton}" Click="SaveUniqueRuleButton_Click" Margin="3,0,3,0"><TextBlock Text="Save" Foreground="White" /></Button>
                                        <Button Style="{StaticResource DangerButton}" Click="DeleteUniqueRuleButton_Click" Margin="6,0,0,0"><TextBlock Text="Delete" Foreground="White" /></Button>
                                    </UniformGrid>
                                    <TextBlock x:Name="UniqueRulesStatusText" Text="Double click a row to edit it." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Style="{StaticResource SecondaryButton}" Click="LoadUniqueRulesButton_Click"><TextBlock Text="Reload rules" /></Button>
                                </StackPanel>
                                <DataGrid x:Name="UniqueRulesGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="UniqueRulesGrid_MouseDoubleClick" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="ChatLogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Chat Logs" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="ChatSearchBox" Width="280" Style="{StaticResource InputBox}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButton}" Click="SearchChatButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Search" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="ChatLogsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" />
                    </Border>
                </Grid>

                <Grid x:Name="SchedulerPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                                <TextBlock Text="Procedure Scheduler" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <TextBlock Text="Enter any database and stored procedure, describe when it repeats, and the engine handles the clockwork."
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Jobs " Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="SchedulerTotalJobsText" Text="0" FontWeight="Bold" />
                                    <TextBlock Text="  Active " Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                                    <TextBlock x:Name="SchedulerActiveJobsText" Text="0" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Click="LoadSchedulerButton_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Reload" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">
                                    <TextBlock x:Name="SchedulerEditorTitleText" Text="New schedule" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="The form uses server local time. Saved jobs are picked up automatically within 30 seconds."
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,16" />
                                    <TextBox x:Name="SchedulerIdBox" Visibility="Collapsed" />

                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="1  PROCEDURE" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="Job name" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                            <TextBox x:Name="SchedulerNameBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                            <TextBlock Text="Database name" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="SchedulerDatabaseBox" Style="{StaticResource InputBox}"
                                                     Margin="0,0,0,10" ToolTip="Example: SRO_VT_SHARD" />
                                            <TextBlock Text="Stored procedure (schema.name)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="SchedulerProcedureBox" Style="{StaticResource InputBox}"
                                                     Margin="0,0,0,10" ToolTip="Example: dbo.MyProcedure" />
                                            <TextBlock Text="Parameters (optional)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="SchedulerArgumentsBox" Style="{StaticResource InputBox}"
                                                     TextWrapping="Wrap" AcceptsReturn="False" Margin="0,0,0,4" />
                                            <TextBlock Text="Enter the database and procedure names manually. Example parameters: @Force = 1, @Mode = N'Quick'."
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="2  REPEAT" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="How often?" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                            <ComboBox x:Name="SchedulerFrequencyBox" SelectionChanged="SchedulerFrequencyBox_SelectionChanged" Margin="0,0,0,10">
                                                <ComboBoxItem Content="Once at a specific date and time" Tag="None" />
                                                <ComboBoxItem Content="Every few minutes, hours, or days" Tag="Interval" IsSelected="True" />
                                                <ComboBoxItem Content="Every day at a fixed time" Tag="Daily" />
                                                <ComboBoxItem Content="Selected weekdays at a fixed time" Tag="Weekly" />
                                            </ComboBox>

                                            <StackPanel x:Name="SchedulerOncePanel" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Date" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="SchedulerOnceDatePicker" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Time" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SchedulerOnceTimeBox" Text="20:00" Style="{StaticResource InputBox}" HorizontalContentAlignment="Center" /></StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="SchedulerIntervalPanel">
                                                <TextBlock Text="Repeat every" Style="{StaticResource FieldLabel}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="SchedulerIntervalValueBox" Text="10" Style="{StaticResource InputBox}" FontSize="18" FontWeight="SemiBold" HorizontalContentAlignment="Center" TextChanged="SchedulerEditorField_Changed" />
                                                    <ComboBox x:Name="SchedulerIntervalUnitBox" Grid.Column="2" SelectionChanged="SchedulerEditorField_Changed">
                                                        <ComboBoxItem Content="Minutes" Tag="Minutes" IsSelected="True" />
                                                        <ComboBoxItem Content="Hours" Tag="Hours" />
                                                        <ComboBoxItem Content="Days" Tag="Days" />
                                                    </ComboBox>
                                                </Grid>
                                                <CheckBox x:Name="SchedulerStartImmediatelyBox" Content="Start immediately, then repeat"
                                                          IsChecked="True" FontWeight="SemiBold" Margin="0,10,0,8"
                                                          Checked="SchedulerStartImmediatelyBox_Changed" Unchecked="SchedulerStartImmediatelyBox_Changed" />
                                                <Grid x:Name="SchedulerIntervalStartPanel" IsEnabled="False">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="First run date" Style="{StaticResource FieldLabel}" /><DatePicker x:Name="SchedulerStartDatePicker" /></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="First run time" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SchedulerStartTimeBox" Text="20:00" Style="{StaticResource InputBox}" HorizontalContentAlignment="Center" /></StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="SchedulerDailyPanel" Visibility="Collapsed">
                                                <TextBlock Text="Run every day at" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SchedulerDailyTimeBox" Text="00:00" Style="{StaticResource InputBox}" Width="150" HorizontalAlignment="Left" HorizontalContentAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <StackPanel x:Name="SchedulerWeeklyPanel" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Run on" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="SchedulerWeeklyTimeBox" Grid.Column="1" Text="20:00" Style="{StaticResource InputBox}" HorizontalContentAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                                                </Grid>
                                                <WrapPanel Margin="0,8,0,6">
                                                    <ToggleButton x:Name="SchedulerMondayBox" Content="Mon" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerTuesdayBox" Content="Tue" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerWednesdayBox" Content="Wed" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerThursdayBox" Content="Thu" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerFridayBox" Content="Fri" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerSaturdayBox" Content="Sat" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                    <ToggleButton x:Name="SchedulerSundayBox" Content="Sun" IsChecked="True" Style="{StaticResource ScheduleDayToggle}" />
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="8,3" Tag="EveryDay" Click="SchedulerDaysPresetButton_Click"><TextBlock Text="Every day" /></Button>
                                                    <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="8,3" Tag="Weekdays" Click="SchedulerDaysPresetButton_Click"><TextBlock Text="Weekdays" /></Button>
                                                    <Button Style="{StaticResource GhostButton}" MinHeight="28" Padding="8,3" Tag="Weekend" Click="SchedulerDaysPresetButton_Click"><TextBlock Text="Weekend" /></Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE823;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock x:Name="SchedulerPreviewText" Text="Every 10 minutes, starting immediately" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="Advanced reliability" Margin="0,0,0,12">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Execution timeout (seconds)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SchedulerTimeoutBox" Text="7200" Style="{StaticResource InputBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Missed-run tolerance (minutes)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SchedulerCatchUpMinutesBox" Text="5" Style="{StaticResource InputBox}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander>

                                    <CheckBox x:Name="SchedulerEnabledBox" Content="Schedule enabled" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Style="{StaticResource PrimaryButton}" Click="SaveSchedulerButton_Click" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save schedule" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="NewSchedulerButton_Click" Margin="5,0,0,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" /><TextBlock Text="New" /></StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource SecondaryButton}" Click="RunSchedulerNowButton_Click" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Run selected now" /></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Click="DeleteSchedulerButton_Click" Margin="5,0,0,0">
                                            <TextBlock Text="Delete selected" Foreground="White" />
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Scheduled procedures" Style="{StaticResource SectionTitle}" />
                                            <TextBlock x:Name="SchedulerNextRunText" Text="No upcoming run." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Select a row to edit" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataGrid x:Name="SchedulerGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              SelectionChanged="SchedulerGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="170" />
                                            <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleSummary}" Width="*" />
                                            <DataGridTextColumn Header="Next run" Binding="{Binding NextRunLocal, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                                            <DataGridTextColumn Header="State" Binding="{Binding JobState}" Width="100" />
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="48" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Recent executions" Style="{StaticResource SectionTitle}" Margin="2,0,2,8" />
                                    <DataGrid x:Name="SchedulerHistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                                            <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerType}" Width="80" />
                                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="90" />
                                            <DataGridTextColumn Header="Duration ms" Binding="{Binding DurationMs}" Width="95" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="SchedulerStatusText" Text="Ready." Style="{StaticResource MutedText}" Margin="4,10,0,0" TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="DiscordPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                                <TextBlock Text="Discord Notifications" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <TextBlock Text="Connect one bot, organize every destination as a simple channel card, and deliver reliable SQL notifications."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshDiscordButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="5*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="22">
                                        <Grid Margin="0,0,0,13">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Discord bot connection" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="The token is encrypted for this Windows server and is never displayed after saving."
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DiscordConnectionDot" Width="7" Height="7"
                                                             Fill="{StaticResource SubtleTextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DiscordConnectionBadgeText" Text="NOT CONFIGURED"
                                                               Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="Bold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <CheckBox x:Name="DiscordEnabledBox" Content="Enable Discord delivery"
                                                  FontWeight="SemiBold" Margin="0,0,0,14" />
                                        <TextBlock Text="Bot Token" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="DiscordBotTokenBox" Margin="0,0,0,5" />
                                        <TextBlock x:Name="DiscordTokenHintText"
                                                   Text="Paste the token from the Discord Developer Portal."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Click="SaveDiscordSettingsButton_Click" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" />
                                                    <TextBlock Text="Save Settings" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Click="TestDiscordBotButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8FB;" Style="{StaticResource FluentIcon}" />
                                                    <TextBlock Text="Test Bot" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1,0,0,0"
                                            Padding="22">
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="6"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    HorizontalAlignment="Left" Margin="0,0,0,13">
                                                <TextBlock Text="&#xE946;" Style="{StaticResource FluentIcon}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="18"
                                                           Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Quick setup" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="1  Create a bot and add it to your Discord server.&#x0a;2  Grant View Channel and Send Messages.&#x0a;3  Save the token, then add the Channel IDs below."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" LineHeight="22" />
                                            <TextBlock Text="No gateway intents or inbound ports are required for notification-only delivery."
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,20,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Notification channels" Style="{StaticResource SectionTitle}" Margin="2,0,0,2" />
                                    <TextBlock Text="Every destination stays visible in the same workspace. Give it a friendly name and paste its Discord Channel ID."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="AddDiscordChannelButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" />
                                        <TextBlock Text="Add Channel" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="DiscordChannelsEmptyPanel"
                                    Style="{StaticResource Panel}"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    Padding="28"
                                    Margin="0,0,0,4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}"
                                               Foreground="{StaticResource SubtleTextBrush}" FontSize="24"
                                               Margin="0,0,0,9" HorizontalAlignment="Center" />
                                    <TextBlock Text="No notification channels yet"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextStrongBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Choose Add Channel to create your first destination."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="DiscordChannelCardsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}"
                                                Width="445"
                                                MinHeight="286"
                                                Margin="0,0,14,14"
                                                Padding="18">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="5"
                                                            Background="{StaticResource AccentSoftBrush}">
                                                        <TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIcon}"
                                                                   Foreground="{StaticResource AccentBrush}" FontSize="15"
                                                                   Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ChannelName, TargetNullValue=New channel}"
                                                                   FontWeight="SemiBold" FontSize="13.5"
                                                                   Foreground="{StaticResource TextStrongBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusMessage}"
                                                                   Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2"
                                                              Content="Enabled"
                                                              IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center" />
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="0,0,0,11">
                                                    <TextBlock Text="Channel Name" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputBox}"
                                                             MaxLength="80"
                                                             ToolTip="Friendly route name used by dbo.Discord_Notification" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Text="Discord Channel ID" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding DiscordChannelID, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource InputBox}"
                                                             MaxLength="20"
                                                             ToolTip="Enable Developer Mode in Discord, then copy the channel ID" />
                                                    <TextBlock Text="Right-click the Discord channel and choose Copy Channel ID."
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="10.5" Margin="1,5,0,0" />
                                                </StackPanel>

                                                <WrapPanel Grid.Row="4" Margin="0,16,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}"
                                                            Click="SaveDiscordChannelButton_Click"
                                                            MinWidth="82" Margin="0,0,7,0">
                                                        <TextBlock Text="Save" />
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Click="TestDiscordChannelButton_Click"
                                                            MinWidth="82" Margin="0,0,7,0">
                                                        <TextBlock Text="Send Test" />
                                                    </Button>
                                                    <Button Style="{StaticResource DangerButton}"
                                                            Click="RemoveDiscordChannelButton_Click"
                                                            MinWidth="82">
                                                        <TextBlock Text="Remove" />
                                                    </Button>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="7*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Send a notification" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Choose a saved destination and queue a message through the same reliable Agent worker."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <TextBlock Text="Destination" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="DiscordManualChannelBox"
                                                  DisplayMemberPath="ChannelName"
                                                  Margin="0,0,0,11" />
                                        <TextBlock Text="Message" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="DiscordManualMessageBox"
                                                 Style="{StaticResource InputBox}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MaxLength="2000"
                                                 MinHeight="112"
                                                 Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,13">
                                            <TextBlock Text="Mentions are disabled for safe automated delivery."
                                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="10.5" />
                                            <TextBlock Text="2,000 characters maximum"
                                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="10.5"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Click="QueueDiscordNotificationButton_Click"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE715;" Style="{StaticResource FluentIcon}" Foreground="White" />
                                                <TextBlock Text="Queue Notification" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Recent delivery" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Latest queued notifications and clear failure reasons."
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                    Click="RetryDiscordNotificationsButton_Click">
                                                <TextBlock Text="Retry Failed" />
                                            </Button>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" MaxHeight="330"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="DiscordActivityList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                                BorderBrush="{StaticResource LineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="11"
                                                                Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding ChannelName}" FontWeight="SemiBold" />
                                                                        <Run Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" />
                                                                        <Run Text="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding MessagePreview}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,4,12,0" />
                                                                    <TextBlock Text="{Binding LastError}"
                                                                               Foreground="{StaticResource RoseBrush}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="10.5"
                                                                               Margin="0,4,12,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding LastError}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Top">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DeliveryStatus}" Value="Sent">
                                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DeliveryStatus}" Value="Failed">
                                                                                    <Setter Property="Background" Value="{StaticResource RoseSoftBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DeliveryStatus}" Value="Pending">
                                                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding DeliveryStatus}" FontSize="9.5" FontWeight="Bold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="DiscordStatusText"
                                       Text="Ready."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="2,12,2,4"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="TelegramPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                                <TextBlock Text="Telegram Notifications" Style="{StaticResource PageTitle}" />
                            </StackPanel>
                            <TextBlock Text="Reliable, queued server announcements with protected credentials and delivery tracking."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshTelegramButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Telegram connection" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="The Bot Token is encrypted for this Windows server before it is stored."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <CheckBox x:Name="TelegramEnabledBox" Content="Telegram Notifications"
                                                  FontWeight="SemiBold" Margin="0,0,0,14" />
                                        <TextBlock Text="Bot Token" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="TelegramBotTokenBox" Margin="0,0,0,5" />
                                        <TextBlock x:Name="TelegramTokenHintText"
                                                   Text="Paste the token issued by BotFather."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" />
                                        <TextBlock Text="Channel ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TelegramChannelIdBox" Style="{StaticResource InputBox}"
                                                 ToolTip="-1001234567890 or @public_channel" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Click="SaveTelegramButton_Click" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Save Settings" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Click="TestTelegramButton_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FB;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Send Test" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Notification rules" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Automated events" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <CheckBox x:Name="TelegramEventReminderBox" Content="Event Reminder" Margin="0,0,0,8" />
                                        <TextBlock Text="Reminder Times (minutes, comma separated)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TelegramReminderMinutesBox" Text="15, 5"
                                                 Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                        <CheckBox x:Name="TelegramEventStartedBox" Content="Event Started" Margin="0,0,0,8" />
                                        <CheckBox x:Name="TelegramEventFinishedBox" Content="Event Finished" Margin="0,0,0,14" />
                                        <TextBlock Text="Server activity" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                                        <CheckBox x:Name="TelegramServerOnlineBox" Content="Server Online" Margin="0,0,0,8" />
                                        <CheckBox x:Name="TelegramFortressWarBox" Content="Fortress War" />
                                        <TextBlock Text="Unique and custom game alerts are queued directly from SQL through dbo.Telegram_Notification."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Manual announcement" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Publish a polished English announcement through the same reliable queue."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <TextBlock Text="Headline" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TelegramAnnouncementTitleBox" Style="{StaticResource InputBox}"
                                                 MaxLength="120" Margin="0,0,0,10" />
                                        <TextBlock Text="Message" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="TelegramAnnouncementBodyBox" Style="{StaticResource InputBox}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 MaxLength="3000" MinHeight="110" Margin="0,0,0,14" />
                                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                                Click="QueueTelegramAnnouncementButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Queue Announcement" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Delivery activity" Style="{StaticResource SectionTitle}" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RetryTelegramButton_Click">
                                                <TextBlock Text="Retry Failed" />
                                            </Button>
                                        </Grid>
                                        <DataGrid Grid.Row="1" x:Name="TelegramDeliveryLogGrid" AutoGenerateColumns="True"
                                                  IsReadOnly="True" CanUserAddRows="False" MinHeight="220" Margin="0,12,0,0" />
                                        <TextBlock Grid.Row="2" Text="Pending messages are delivered by the Agent service with automatic retry."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="TelegramStatusText" Text="Ready."
                                       Foreground="{StaticResource MutedBrush}" Margin="2,12,2,4" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="WebViewerPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="WebViewer Buttons" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="LoadWebViewerButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Add web button" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebNameBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Icon path" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebIconBox" Text="clientlibrary\guides\kmt_web_viewer_1.ddj" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="URL" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebUrlBox" Text="https://example.com" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Frame width" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebWidthBox" Text="1000" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Frame height" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebHeightBox" Text="650" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <TextBlock Text="Display order" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WebOrderBox" Text="0" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                                <CheckBox x:Name="WebEnabledBox" Content="Enabled" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,14" />
                                <Button Style="{StaticResource PrimaryButton}" Click="AddWebViewerButton_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Add Button" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Buttons (double click to enable/disable)" Style="{StaticResource SectionTitle}" />
                                <DataGrid x:Name="WebViewerGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="WebViewerGrid_MouseDoubleClick" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="PacketRulesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
