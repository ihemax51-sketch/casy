                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource AccentBrush}" FontSize="22" />
                            <TextBlock Text="Packet Rules" Style="{StaticResource PageTitle}" />
                        </StackPanel>
