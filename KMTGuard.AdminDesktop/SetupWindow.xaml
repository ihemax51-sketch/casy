<Window x:Class="KMTGuard.AdminDesktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KMTGuard Guided Setup"
        Width="1080"
        Height="720"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/Brand/kmt.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SetupStepItemStyle" TargetType="ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource WindowFrameBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="Assets/Brand/kmt-logo.png" Width="30" Height="30" Stretch="Uniform" />
                        <TextBlock Text="KMTGuard" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Border Width="1" Height="19" Background="{StaticResource LineBrush}" Margin="13,0" />
                        <TextBlock Text="GUIDED SETUP" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowCommandButton}" Click="MinimizeButton_Click" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close setup" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#ECF3FA" Offset="0" />
                            <GradientStop Color="#F4EEE3" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="26,30,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="66" Height="66" CornerRadius="15" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <Image Source="Assets/Brand/kmt-logo.png" Width="56" Height="56" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Server readiness" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" Margin="0,17,0,0" />
                            <TextBlock Text="A clear path from activation to a healthy running filter."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,7,0,22" />
                        </StackPanel>

                        <ListBox x:Name="StepsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Steps}"
                                 ItemContainerStyle="{StaticResource SetupStepItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsHitTestVisible="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="StepCard"
                                            Background="#72FFFFFF"
                                            BorderBrush="#96D7CDBD"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="11,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="27" Height="27" CornerRadius="14" Background="{Binding NumberBackground}" BorderBrush="{Binding NumberBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding Number}" Foreground="{Binding NumberForeground}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,5,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding StatusBrush}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="StepCard" Property="Background" Value="#FFFFFF" />
                                            <Setter TargetName="StepCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="StepCard" Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#B8FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="SAFE SETUP" Style="{StaticResource EyebrowText}" Foreground="{StaticResource BrandGoldBrush}" />
                                <TextBlock Text="Passwords are never included in the support report." FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="34,28,34,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageEyebrowText" Text="STEP 1 OF 5" Style="{StaticResource EyebrowText}" />
                            <TextBlock x:Name="PageTitleText" Text="Welcome to KMTGuard" Style="{StaticResource PageTitle}" Margin="0,5,0,0" />
                            <TextBlock x:Name="PageSubtitleText" Text="We will verify the essentials before any service is started." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Top">
                            <TextBlock x:Name="OverallStatusText" Text="SETUP REQUIRED" Foreground="{StaticResource AccentBrush}" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="34,0,34,20">
                        <Grid x:Name="WelcomePage">
                            <StackPanel VerticalAlignment="Center" MaxWidth="650">
                                <Border Background="#E9DECB" BorderBrush="#D1BE9D" BorderThickness="1" CornerRadius="8" Padding="26,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Your license is active" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                                            <TextBlock x:Name="LicenseCustomerText" Text="Licensed workspace" FontSize="12.5" Margin="0,7,0,0" />
                                            <TextBlock x:Name="LicenseDetailText" Text="Subscription details" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="What this setup verifies" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Panel}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="18" />
                                            <TextBlock Text="Database access" FontWeight="SemiBold" Margin="0,10,0,0" />
                                            <TextBlock Text="SQL credentials and the selected KMTGuard database." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="18" />
                                            <TextBlock Text="Runtime readiness" FontWeight="SemiBold" Margin="0,10,0,0" />
                                            <TextBlock Text="Files, server identity, required objects, and all three services." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="DatabasePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="690" HorizontalAlignment="Left">
                                <Border Style="{StaticResource Panel}" Padding="20">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SQL SERVER" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SqlHostBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="PORT (OPTIONAL)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SqlPortBox" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SQL USERNAME" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SqlUsernameBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SQL PASSWORD" Style="{StaticResource FieldLabel}" />
                                                <PasswordBox x:Name="SqlPasswordBox" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="KMTGUARD DATABASE" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="ProxyDatabaseBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="THIS SERVER IP" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="ServerIpBox" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DatabaseResultPanel" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DatabaseResultIcon" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock x:Name="DatabaseResultText" Grid.Column="1" Text="Enter the connection details supplied for this server." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PreflightPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="PreflightList" ItemsSource="{Binding PreflightChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Panel}" Padding="15,13" Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{Binding IconBackground}">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding IconBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding IconBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ReadinessPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border x:Name="ReadinessSummaryPanel" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="15,13" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock x:Name="ReadinessSummaryIcon" Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="ReadinessSummaryTitle" Text="Ready for inspection" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ReadinessSummaryText" Text="Required database components will be checked without changing data." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="ReadinessList" ItemsSource="{Binding ReadinessChecks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="13,10" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding IconBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding IconBrush}" FontSize="9.5" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="LaunchPage" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" MaxWidth="650">
                                <Border x:Name="LaunchHeroPanel" Background="#E9DECB" BorderBrush="#D1BE9D" BorderThickness="1" CornerRadius="8" Padding="28,25">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border x:Name="LaunchIconPanel" Width="62" Height="62" CornerRadius="31" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock x:Name="LaunchIconText" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="LaunchTitleText" Text="Ready to start KMTGuard" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" HorizontalAlignment="Center" Margin="0,17,0,0" />
                                        <TextBlock x:Name="LaunchDetailText" Text="Your verified settings will be saved and all three services will be started in the correct order." Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
                                    <TextBlock x:Name="LaunchStatusText" Text="No service action has been performed yet." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Click="CopySupportReportButton_Click" ToolTip="Copy a password-free diagnostic summary">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource FluentIcon}" /><TextBlock Text="Copy support report" /></StackPanel>
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="ReviewUpdatesButton" Style="{StaticResource SecondaryButton}" Click="ReviewUpdatesButton_Click" Margin="0,0,9,0" Visibility="Collapsed">
                                    <TextBlock Text="Review database updates" />
                                </Button>
                                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Click="BackButton_Click" Margin="0,0,9,0" Visibility="Collapsed">
                                    <TextBlock Text="Back" />
                                </Button>
                                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="PrimaryButton_Click" Width="174">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PrimaryButtonIcon" Text="&#xE76C;" Style="{StaticResource FluentIcon}" Foreground="White" />
                                        <TextBlock x:Name="PrimaryButtonText" Text="Begin setup" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
