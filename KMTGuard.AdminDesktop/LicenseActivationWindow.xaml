<Window x:Class="KMTGuard.AdminDesktop.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KMTGuard Activation"
        Width="780"
        Height="580"
        MinWidth="780"
        MinHeight="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/Brand/kmt.ico"
        Opacity="0"
        ContentRendered="ActivationWindow_ContentRendered"
        Closing="ActivationWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource WindowFrameBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="0.985" ScaleY="0.985" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                        <Image Width="28" Height="28" Source="Assets/Brand/kmt-logo.png" Stretch="Uniform" />
                        <TextBlock Text="KMTGuard" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Width="1" Height="18" Background="{StaticResource LineBrush}" Margin="12,0" />
                        <TextBlock Text="LICENSE ACTIVATION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCloseButton}"
                            Height="51"
                            Click="CloseWindowButton_Click"
                            ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F2F7FD" Offset="0" />
                            <GradientStop Color="#E9F2FB" Offset="0.62" />
                            <GradientStop Color="#F8F4E9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="96" Height="96" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Left">
                                <Image Width="82" Height="82" Source="Assets/Brand/kmt-logo.png" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Activate KMTGuard" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" Margin="0,24,0,0" />
                            <TextBlock Text="Link this Windows server to your licensed workspace before services can start."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                    <TextBlock Text="1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Connect" FontWeight="SemiBold" />
                                    <TextBlock Text="Reach the license service" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
                                    <TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Bind" FontWeight="SemiBold" />
                                    <TextBlock Text="Verify this server ID" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFFF" BorderBrush="{StaticResource StrongLineBrush}" BorderThickness="1">
                                    <TextBlock Text="3" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Launch" FontWeight="SemiBold" />
                                    <TextBlock Text="Open the operations center" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="SECURE SERVER BINDING" Style="{StaticResource EyebrowText}" Foreground="{StaticResource BrandGoldBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="36,30,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="License activation" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
                        <TextBlock Text="Enter the details supplied with your KMTGuard subscription." Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource AmberSoftBrush}" BorderBrush="#E8D2A7" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,18,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AmberBrush}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" Foreground="#765318" FontSize="11.5" LineHeight="17" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="LICENSE SERVER URL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServerUrlBox" />
                        <TextBlock Text="ACTIVATION KEY" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" />
                        <TextBox x:Name="ActivationKeyBox" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <TextBlock Text="THIS SERVER ID" Style="{StaticResource FieldLabel}" />
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="11,5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="MachineIdText" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="32" Height="30" MinHeight="30" Padding="0" Click="CopyMachineIdButton_Click" ToolTip="Copy server ID">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource FluentIcon}" Margin="0" />
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="The first successful activation permanently binds this subscription to this Windows server."
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Width="92" IsCancel="True">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Width="160" Margin="9,0,0,0" Click="ActivateButton_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" Foreground="White" /><TextBlock Text="Activate server" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
